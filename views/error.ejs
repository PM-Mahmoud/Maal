<!DOCTYPE html>
<html lang="en-AU">
<head>
  <%- include('partials/v2-head', { title: 'Something went wrong' }) %>
</head>
<body class="v2 v2-focus-page">
  <%- include('partials/v2-focus-header', { backHref: '/' }) %>
  <main class="v2-focus">
    <div class="v2-focus-inner">
      <h1 class="v2-focus-title">Something went wrong</h1>
      <p class="v2-focus-sub"><%= locals.message || 'Please try again.' %></p>
      <div class="v2-focus-actions"><a href="/app" class="v2-btn v2-btn-ink">Back to Maal</a></div>
    </div>
  </main>
  <%- include('partials/v2-focus-footer') %>
</body>
</html>
