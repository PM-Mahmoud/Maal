<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <title><%= pageTitle %> — Mizan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js" defer></script>
  <script>
    // Apply saved theme before paint (default: light)
    (function() {
      try {
        var t = localStorage.getItem('mizan-theme') || 'light';
        document.documentElement.setAttribute('data-theme', t);
        if (localStorage.getItem('mizan-privacy') === 'on') {
          document.documentElement.setAttribute('data-privacy', 'on');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="app-body">
  <!-- Mobile top bar -->
  <div class="mobile-topbar">
    <button class="icon-btn" id="mobile-menu" title="Menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a href="/dashboard" class="sidebar-logo" style="margin:0; font-size:1.2rem;"><span class="mark">◈</span> Mizan</a>
    <span style="width:34px;"></span>
  </div>
  <div class="sidebar-overlay" id="sidebar-overlay"></div>
  <div class="app">
    <aside class="sidebar">
      <a href="/dashboard" class="sidebar-logo"><span class="mark">◈</span> Mizan</a>

      <a href="/dashboard" class="side-item <%= pageTitle === 'Dashboard' ? 'active' : '' %>">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        Dashboard
      </a>
      <a href="/dashboard/ask" class="side-item <%= pageTitle === 'Ask Mizan' ? 'active' : '' %>">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8z"/></svg>
        Ask Mizan
      </a>
      <a href="/dashboard/research" class="side-item <%= pageTitle === 'Research' ? 'active' : '' %>">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        Research
      </a>
      <a href="/dashboard/radar" class="side-item <%= pageTitle === 'Radar' ? 'active' : '' %>">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12 18 6"/></svg>
        Radar
      </a>

      <div class="side-group">My Portfolio</div>
      <a href="/dashboard/assets" class="side-item side-sub <%= pageTitle === 'Assets & Liabilities' ? 'active' : '' %>">Assets &amp; Liabilities</a>
      <a href="/dashboard/vault" class="side-item side-sub <%= pageTitle === 'Vault' ? 'active' : '' %>">Vault</a>
      <a href="/dashboard/transactions" class="side-item side-sub <%= pageTitle === 'Transactions' ? 'active' : '' %>">Transactions</a>
      <a href="/dashboard/accounts" class="side-item side-sub <%= pageTitle === 'Linked Accounts' ? 'active' : '' %>">Linked Accounts</a>
      <a href="/dashboard/goals" class="side-item side-sub <%= pageTitle === 'Goals' ? 'active' : '' %>">Goals</a>
      <a href="/dashboard/profile" class="side-item side-sub <%= pageTitle === 'Profile' ? 'active' : '' %>">Profile</a>

      <div class="side-group">Insights</div>
      <a href="/dashboard/scores" class="side-item side-sub <%= pageTitle === 'Scores' ? 'active' : '' %>">Scores</a>
      <a href="/dashboard/recommendations" class="side-item side-sub <%= pageTitle === 'Recommendations' ? 'active' : '' %>">Action Plan</a>
      <a href="/dashboard/portfolio" class="side-item side-sub <%= pageTitle === 'Portfolio' ? 'active' : '' %>">Portfolio Plan</a>
      <a href="/dashboard/tools" class="side-item side-sub <%= pageTitle === 'Recommended Tools' ? 'active' : '' %>">Tools</a>

      <div class="side-divider"></div>
      <a href="#" class="side-item" id="feedback-open">Share Feedback</a>
      <a href="/dashboard/roadmap" class="side-item <%= pageTitle === 'Roadmap' ? 'active' : '' %>">Roadmap</a>
      <a href="mailto:support@mizan.au" class="side-item">Support</a>

      <div class="sidebar-bottom">
        <button type="button" class="icon-btn" id="theme-toggle" title="Toggle light/dark">
          <svg id="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button type="button" class="icon-btn" id="privacy-toggle" title="Privacy mode — blur balances">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
        <a href="/dashboard/settings" class="icon-btn" title="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3h.1a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5h.1a1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
        </a>
        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit" class="icon-btn" title="Sign out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
          </button>
        </form>
      </div>
    </aside>

    <main class="main">
      <%- body %>
      <div class="disclaimer">
        DISCLAIMER: Mizan does not provide financial advice. Any information provided
        by Mizan is for educational purposes only. You should do your own research.
        Investing is risky and you can lose all of your money.
      </div>
    </main>
  </div>

  <!-- Floating Mizan chat -->
  <div class="chat-panel" id="chat-panel">
    <div class="chat-head">
      <div class="avatar" style="width:34px;height:34px;font-size:0.85rem;">M</div>
      <div>
        <div style="font-size:0.88rem;font-weight:600;">Chat with Mizan</div>
        <div class="status">● Online</div>
      </div>
      <button class="icon-btn chat-close" id="chat-close" title="Close">✕</button>
    </div>
    <div class="chat-body" id="chat-body">
      <div class="chat-msg bot">Hey <%= (session.name || 'there').split(' ')[0] %>, how can I help you today? I can help you understand your portfolio, track expenses, and explain what's going on in your finances.</div>
    </div>
    <div class="chat-input-row">
      <input type="text" id="chat-input" placeholder="Ask me anything about your finances">
      <button class="chat-send" id="chat-send" title="Send">↑</button>
    </div>
    <div class="chat-disclaimer">Educational guidance only — not financial advice.</div>
  </div>
  <button class="chat-fab" id="chat-fab" title="Chat with Mizan">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8z"/></svg>
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Floating chat open/close (messaging logic lives in /js/app.js)
      var fab = document.getElementById('chat-fab');
      var panel = document.getElementById('chat-panel');
      var chatClose = document.getElementById('chat-close');
      if (fab && panel) {
        fab.addEventListener('click', function() {
          panel.classList.toggle('open');
          if (panel.classList.contains('open')) document.getElementById('chat-input').focus();
        });
        chatClose.addEventListener('click', function() { panel.classList.remove('open'); });
      }

      // Mobile sidebar
      var menuBtn = document.getElementById('mobile-menu');
      var sidebar = document.querySelector('.sidebar');
      var overlay = document.getElementById('sidebar-overlay');
      if (menuBtn && sidebar) {
        menuBtn.addEventListener('click', function() {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('show');
        });
        overlay.addEventListener('click', function() {
          sidebar.classList.remove('open');
          overlay.classList.remove('show');
        });
      }

      // Theme toggle
      var toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', function() {
          var cur = document.documentElement.getAttribute('data-theme') || 'light';
          var next = cur === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('mizan-theme', next); } catch (e) {}
        });
      }

      // Privacy mode — blur every balance on screen
      var privacy = document.getElementById('privacy-toggle');
      if (privacy) {
        privacy.addEventListener('click', function() {
          var on = document.documentElement.getAttribute('data-privacy') === 'on';
          if (on) document.documentElement.removeAttribute('data-privacy');
          else document.documentElement.setAttribute('data-privacy', 'on');
          try { localStorage.setItem('mizan-privacy', on ? 'off' : 'on'); } catch (e) {}
        });
      }

      // Legacy: recommendation accept/dismiss
      document.querySelectorAll('.rec-accept, .rec-dismiss').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var recId = btn.getAttribute('data-id');
          var status = btn.classList.contains('rec-accept') ? 'accepted' : 'dismissed';
          try {
            var res = await fetch('/dashboard/recommendations/' + recId + '/status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: status })
            });
            if (res.ok) {
              var item = btn.closest('.rec-item');
              item.style.opacity = '0.5';
              item.style.pointerEvents = 'none';
            }
          } catch(e) { console.error(e); }
        });
      });

      // Legacy: delete linked account
      document.querySelectorAll('.delete-account').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          if (!confirm('Remove this linked account?')) return;
          var id = btn.getAttribute('data-id');
          try {
            var res = await fetch('/dashboard/accounts/' + id, { method: 'DELETE' });
            if (res.ok) btn.closest('.account-item').remove();
          } catch(e) { console.error(e); }
        });
      });

      // Legacy: add account modal
      var addBtn = document.getElementById('add-account-btn');
      var modal = document.getElementById('add-account-modal');
      if (addBtn && modal) {
        addBtn.addEventListener('click', function() { modal.style.display = 'flex'; });
        modal.querySelector('.modal-cancel').addEventListener('click', function() { modal.style.display = 'none'; });
        modal.querySelector('.modal-submit').addEventListener('click', async function() {
          var form = modal.querySelector('form');
          var data = new FormData(form);
          var obj = {};
          data.forEach(function(v, k) { obj[k] = v; });
          var res = await fetch('/dashboard/accounts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(obj) });
          if (res.ok) { modal.style.display = 'none'; form.reset(); location.reload(); }
        });
      }
    });
  </script>
</body>
</html>
