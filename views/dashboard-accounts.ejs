<div class="page-header">
  <h1>Linked Accounts</h1>
  <p>Connect your financial institutions for a complete picture of your finances.</p>
</div>

<!-- Connect Your Accounts -->
<div class="accounts-connect-section">
  <div class="connect-section-left">
    <div class="connect-section-icon">⬡</div>
    <div>
      <h2>Connect with Basiq</h2>
      <p>Securely connect your bank accounts, super funds, and investment accounts via open banking. No re-entry of statements needed.</p>
    </div>
  </div>
  <button id="basiq-connect-btn" class="btn-primary">Connect account</button>
</div>

<div class="accounts-subheading">
  <h3>Or add accounts manually</h3>
  <button id="add-account-btn" class="btn-secondary">+ Add manually</button>
</div>

<!-- Connected Accounts List -->
<% if (accounts && accounts.length) { %>
<div class="card">
  <div class="card-title">Connected Accounts (<%= accounts.length %>)</div>
  <% accounts.forEach(function(acc) { %>
    <div class="account-item" id="account-<%= acc.id %>">
      <div class="account-icon-wrap">
        <div class="account-type-icon"><%= acc.institution_type === 'super_fund' ? '◈' : acc.institution_type === 'broker' ? '◈' : '◈' %></div>
      </div>
      <div class="account-info">
        <div class="account-name"><%= acc.institution_name %>
          <% if (acc.account_reference) { %><span class="account-ref">•• <%= acc.account_reference %></span><% } %>
        </div>
        <div class="account-meta">
          <span class="account-type-label"><%= acc.institution_type === 'super_fund' ? 'Super Fund' : acc.institution_type === 'broker' ? 'Broker / Investment' : acc.institution_type === 'bank' ? 'Bank Account' : acc.institution_type || 'Account' %></span>
          <% if (acc.balance) { %> · <%= '$' + acc.balance.toLocaleString('en-AU') %><% } %>
          <% if (acc.last_synced_at) { %> · Synced <%= new Date(acc.last_synced_at).toLocaleDateString('en-AU', {day:'numeric',month:'short'}) %><% } %>
        </div>
      </div>
      <div class="account-actions">
        <span class="status-badge status-<%= acc.connection_status || 'connected' %>"><%= acc.connection_status === 'active' ? 'Connected' : acc.connection_status === 'reconnect_needed' ? 'Reconnect needed' : acc.connection_status === 'error' ? 'Error' : 'Connected' %></span>
        <button class="btn-icon sync-account" data-id="<%= acc.id %>" title="Sync now">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
        </button>
        <button class="btn-icon reconnect-account" data-id="<%= acc.id %>" title="Reconnect">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15"/></svg>
        </button>
        <button class="btn-icon-danger delete-account" data-id="<%= acc.id %>" title="Remove">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  <% }); %>
</div>
<% } else { %>
<div class="empty-state">
  <div class="icon">◈</div>
  <h3>No accounts linked yet</h3>
  <p>Link your bank accounts, super funds, and investment accounts to get a complete picture of your finances.</p>
</div>
<% } %>


<!-- ─── Basiq Connection Modal ───────────────────────────────────── -->
<div id="basiq-modal" class="modal-overlay">
  <div class="modal basiq-modal">

    <!-- Step 1: Institution Search -->
    <div id="basiq-step-search" class="basiq-step">
      <div class="modal-header">
        <h2>Connect your financial institution</h2>
        <p>Search for your bank, super fund, or broker to get started.</p>
      </div>
      <div class="basiq-search-wrap">
        <svg class="basiq-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="basiq-search-input" placeholder="Search institutions... (e.g. CBA, NAB, Australian Super)" autocomplete="off">
      </div>
      <div class="basiq-institution-list" id="basiq-institution-list">
        <!-- Populated by JS -->
      </div>
      <div class="modal-footer-note">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        Your credentials are sent directly to Basiq — we never see them.
      </div>
    </div>

    <!-- Step 2: Connecting (Loading) -->
    <div id="basiq-step-loading" class="basiq-step" style="display:none;">
      <div class="basiq-connecting">
        <div class="basiq-spinner"></div>
        <h3 id="basiq-loading-title">Connecting to...</h3>
        <p id="basiq-loading-sub">Establishing secure connection</p>
      </div>
    </div>

    <!-- Step 3: Success -->
    <div id="basiq-step-success" class="basiq-step" style="display:none;">
      <div class="basiq-result basiq-result-success">
        <div class="result-icon result-icon-success">✓</div>
        <h3>Account connected successfully!</h3>
        <p id="basiq-success-name"></p>
      </div>
      <button id="basiq-success-done" class="btn-primary" style="width:100%;">Done</button>
    </div>

    <!-- Step 4: Error -->
    <div id="basiq-step-error" class="basiq-step" style="display:none;">
      <div class="basiq-result basiq-result-error">
        <div class="result-icon result-icon-error">✕</div>
        <h3>Connection failed</h3>
        <p id="basiq-error-message">Something went wrong. Please try again.</p>
      </div>
      <button id="basiq-error-retry" class="btn-primary" style="width:100%;">Try again</button>
      <button id="basiq-error-cancel" class="btn-secondary" style="width:100%;margin-top:0.5rem;">Cancel</button>
    </div>

  </div>
</div>


<!-- ─── Manual Account Entry Modal ───────────────────────────────── -->
<div id="add-account-modal" class="modal-overlay">
  <div class="modal">
    <div class="modal-header">
      <h2>Add account manually</h2>
      <p>Enter your institution details. You can update the balance anytime.</p>
    </div>
    <form id="manual-account-form">
      <div class="form-group">
        <label for="institution_name">Institution name</label>
        <input type="text" id="institution_name" name="institution_name" placeholder="e.g. Commonwealth Bank" required>
      </div>
      <div class="form-group">
        <label for="institution_type">Account type</label>
        <select id="institution_type" name="institution_type">
          <option value="bank">Bank account</option>
          <option value="super_fund">Super fund</option>
          <option value="broker">Broker / investment</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label for="account_reference">Account reference (last 4 digits)</label>
        <input type="text" id="account_reference" name="account_reference" placeholder="1234" maxlength="4">
      </div>
      <div class="form-group">
        <label for="balance">Approximate balance ($)</label>
        <input type="number" id="balance" name="balance" placeholder="0" min="0" step="100">
      </div>
    </form>
    <div class="modal-actions">
      <button class="btn-secondary modal-cancel">Cancel</button>
      <button class="btn-primary modal-submit" id="manual-account-submit">Add account</button>
    </div>
  </div>
</div>


<!-- ─── Delete Confirmation Modal ───────────────────────────────── -->
<div id="delete-modal" class="modal-overlay">
  <div class="modal" style="max-width:380px;">
    <div class="modal-header">
      <h2>Remove account</h2>
      <p>Are you sure you want to remove this account? This cannot be undone.</p>
    </div>
    <div class="modal-actions">
      <button class="btn-secondary modal-cancel">Cancel</button>
      <button class="btn-danger" id="delete-confirm-btn">Remove</button>
    </div>
  </div>
</div>


