  margin: 0 auto 1.25rem;
}
@keyframes spin { to { transform: rotate(360deg); } }
.basiq-connecting h3 { font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; color: var(--fg); margin: 0 0 0.35rem; }
.basiq-connecting p { font-size: 0.85rem; color: var(--fg-muted); margin: 0; }
