</style>

<script>
// ─── Institution data (mock) ────────────────────────────────────────────────
// TODO: Replace mock Basiq flow with actual Basiq SDK integration.
// See: https://docs.basiq.io/docs/affordability-get-consent
// Basiq provides an embeddable consent UI; replace the mock steps below.
const INSTITUTIONS = [
  { id: 'cba', name: 'Commonwealth Bank', short: 'CBA', type: 'Bank', category: 'bank' },
  { id: 'nab', name: 'National Australia Bank', short: 'NAB', type: 'Bank', category: 'bank' },
  { id: 'anz', name: 'ANZ', short: 'ANZ', type: 'Bank', category: 'bank' },
  { id: 'westpac', name: 'Westpac', short: 'WBC', type: 'Bank', category: 'bank' },
  { id: 'boq', name: 'Bank of Queensland', short: 'BOQ', type: 'Bank', category: 'bank' },
  { id: 'suncorp', name: 'Suncorp Bank', short: 'SUNC', type: 'Bank', category: 'bank' },
  { id: 'macquarie', name: 'Macquarie Bank', short: 'MQG', type: 'Bank', category: 'bank' },
  { id: 'ing', name: 'ING', short: 'ING', type: 'Bank', category: 'bank' },
  { id: 'ubank', name: 'UBank', short: 'UBK', type: 'Bank', category: 'bank' },
  { id: 'bankaus', name: 'Bank of Australia', short: 'BFL', type: 'Bank', category: 'bank' },
  { id: 'hostplus', name: 'Hostplus', short: 'HST', type: 'Super Fund', category: 'super_fund' },
  { id: 'australianSuper', name: 'AustralianSuper', short: 'AUS', type: 'Super Fund', category: 'super_fund' },
  { id: 'rest', name: 'REST Super', short: 'RST', type: 'Super Fund', category: 'super_fund' },
  { id: 'unisuper', name: 'UniSuper', short: 'UNI', type: 'Super Fund', category: 'super_fund' },
  { id: 'amp', name: 'AMP', short: 'AMP', type: 'Super Fund', category: 'super_fund' },
  { id: 'cmc', name: 'CMC Markets', short: 'CMC', type: 'Broker', category: 'broker' },
  { id: 'ig', name: 'IG Markets', short: 'IG', type: 'Broker', category: 'broker' },
  { id: 'commsec', name: 'CommSec', short: 'CSEC', type: 'Broker', category: 'broker' },
];

// ─── Render institution list ─────────────────────────────────────────────────
function renderInstitutions(query) {
  const list = document.getElementById('basiq-institution-list');
  const q = query.toLowerCase().trim();
  const filtered = q ? INSTITUTIONS.filter(i => i.name.toLowerCase().includes(q) || i.short.toLowerCase().includes(q) || i.type.toLowerCase().includes(q)) : INSTITUTIONS;

  if (!filtered.length) {
    list.innerHTML = '<p style="text-align:center;color:var(--fg-muted);padding:1rem;font-size:0.85rem;">No institutions found.</p>';
    return;
  }

  list.innerHTML = filtered.map(inst => `
    <div class="basiq-institution-item" data-id="${inst.id}" data-name="${inst.name}" data-type="${inst.category}">
      <div class="basiq-institution-info">
        <div class="basiq-institution-logo">${inst.short}</div>
        <div>
          <div class="basiq-institution-name">${inst.name}</div>
          <div class="basiq-institution-type">${inst.type}</div>
        </div>
      </div>
      <button class="basiq-institution-connect">Connect</button>
    </div>
  `).join('');

  // Click on row or button to start connection
  list.querySelectorAll('.basiq-institution-item').forEach(row => {
    row.addEventListener('click', (e) => {
      // Skip if clicking the connect button is handled separately
      startMockConnection(row.dataset.id, row.dataset.name, row.dataset.type);
    });
  });
}

renderInstitutions('');

// ─── Search filter ────────────────────────────────────────────────────────────
document.getElementById('basiq-search-input').addEventListener('input', (e) => {
  renderInstitutions(e.target.value);
});

// ─── Mock Basiq connection flow ───────────────────────────────────────────────
let pendingDeleteAccountId = null;

function showStep(step) {
  ['search', 'loading', 'success', 'error'].forEach(s => {
    document.getElementById('basiq-step-' + s).style.display = s === step ? 'block' : 'none';
  });
}

function startMockConnection(instId, instName, instType) {
  // TODO: Replace with actual Basiq SDK call.
  // Mock: show loading → fake 2.5s delay → success (90%) or error (10%)
  document.getElementById('basiq-loading-title').textContent = 'Connecting to ' + instName + '...';
  document.getElementById('basiq-loading-sub').textContent = 'Establishing secure connection via Basiq';
  showStep('loading');

  setTimeout(() => {
    const isError = Math.random() < 0.1; // 10% mock error rate for demo
    if (isError) {
      document.getElementById('basiq-error-message').textContent = 'Could not connect to ' + instName + '. Please check your credentials and try again.';
      showStep('error');
    } else {
      document.getElementById('basiq-success-name').textContent = instName + ' has been successfully linked to your account.';
      showStep('success');
    }
  }, 2500);
}

// Save on success
document.getElementById('basiq-success-done').addEventListener('click', async () => {
  // Read the last connected institution from the loading step text
  const title = document.getElementById('basiq-loading-title').textContent;
  const name = title.replace('Connecting to ', '');
  // Find institution details from our data
  const inst = INSTITUTIONS.find(i => i.name === name) || { category: 'bank', short: name.substring(0,3).toUpperCase() };

  try {
    await fetch('/dashboard/accounts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ institution_name: name, institution_type: inst.category })
    });
    closeBasiqModal();
    location.reload();
  } catch(e) { console.error(e); closeBasiqModal(); }
});

// Error retry → back to search
document.getElementById('basiq-error-retry').addEventListener('click', () => showStep('search'));
document.getElementById('basiq-error-cancel').addEventListener('click', () => closeBasiqModal());

// Basiq modal open/close
function closeBasiqModal() {
  document.getElementById('basiq-modal').style.display = 'none';
  showStep('search');
}

document.getElementById('basiq-connect-btn').addEventListener('click', () => {
  document.getElementById('basiq-modal').style.display = 'flex';
  showStep('search');
  document.getElementById('basiq-search-input').value = '';
  renderInstitutions('');
});

// Close modal on overlay click
document.getElementById('basiq-modal').addEventListener('click', (e) => {
  if (e.target === e.currentTarget) closeBasiqModal();
});

// ─── Manual account add ───────────────────────────────────────────────────────
var addModal = document.getElementById('add-account-modal');
document.getElementById('add-account-btn').addEventListener('click', () => {
  addModal.style.display = 'flex';
});
addModal.querySelector('.modal-cancel').addEventListener('click', () => { addModal.style.display = 'none'; });
addModal.addEventListener('click', (e) => { if (e.target === addModal) addModal.style.display = 'none'; });

document.getElementById('manual-account-submit').addEventListener('click', async () => {
  var form = document.getElementById('manual-account-form');
  var data = new FormData(form);
  var obj = {};
  data.forEach((v, k) => { obj[k] = v; });
  if (!obj.institution_name) return;

  var submitBtn = document.getElementById('manual-account-submit');
  submitBtn.disabled = true;
  submitBtn.textContent = 'Adding...';

  try {
    var res = await fetch('/dashboard/accounts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(obj)
    });
    if (res.ok) {
      addModal.style.display = 'none';
      form.reset();
      location.reload();
    }
  } catch(e) { console.error(e); }
  submitBtn.disabled = false;
  submitBtn.textContent = 'Add account';
});

// ─── Delete account ───────────────────────────────────────────────────────────
var deleteModal = document.getElementById('delete-modal');
deleteModal.querySelector('.modal-cancel').addEventListener('click', () => { deleteModal.style.display = 'none'; pendingDeleteAccountId = null; });
deleteModal.addEventListener('click', (e) => { if (e.target === deleteModal) { deleteModal.style.display = 'none'; pendingDeleteAccountId = null; } });
document.getElementById('delete-confirm-btn').addEventListener('click', async () => {
  if (!pendingDeleteAccountId) return;
  try {
    var res = await fetch('/dashboard/accounts/' + pendingDeleteAccountId, { method: 'DELETE' });
    if (res.ok) {
      var item = document.getElementById('account-' + pendingDeleteAccountId);
      if (item) item.remove();
    }
  } catch(e) { console.error(e); }
  deleteModal.style.display = 'none';
  pendingDeleteAccountId = null;
});

document.querySelectorAll('.delete-account').forEach(btn => {
  btn.addEventListener('click', () => {
    pendingDeleteAccountId = btn.getAttribute('data-id');
    deleteModal.style.display = 'flex';
  });
});

// ─── Sync account ─────────────────────────────────────────────────────────────
document.querySelectorAll('.sync-account').forEach(btn => {
  btn.addEventListener('click', async () => {
    var id = btn.getAttribute('data-id');
    var icon = btn.querySelector('svg');
    icon.style.animation = 'spin 1s linear infinite';
    btn.disabled = true;
    try {
      await fetch('/dashboard/accounts/' + id + '/sync', { method: 'POST' });
      location.reload();
    } catch(e) { console.error(e); icon.style.animation = ''; btn.disabled = false; }
  });
});

// ─── Reconnect account ────────────────────────────────────────────────────────
document.querySelectorAll('.reconnect-account').forEach(btn => {
  btn.addEventListener('click', () => {
    // Open Basiq modal to "reconnect" — same flow as new connect
    document.getElementById('basiq-modal').style.display = 'flex';
    showStep('search');
  });
});
</script>