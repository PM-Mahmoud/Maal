.modal-footer-note { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--fg-muted); margin-top: 1rem; opacity: 0.7; }
.basiq-search-wrap {
  position: relative;
  margin-bottom: 0.85rem;
}
