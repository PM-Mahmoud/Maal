<div class="page-head" style="justify-content:center;">
  <div style="text-align:center;">
    <h1>My Vault</h1>
    <div class="sub">Upload documents to your vault</div>
  </div>
</div>

<div style="max-width: 680px; margin: 0 auto;">

  <% var vaultFiles = (typeof files !== 'undefined' && files) ? files : []; %>

  <div class="dropzone" data-dropzone="vault" data-kind="vault">
    <div style="font-size:1.6rem; margin-bottom:0.5rem;">⇪</div>
    <strong>Drop files here or click to browse</strong>
    <p style="margin:0.4rem 0 0; font-size:0.78rem;">Images, PDF, Word and CSV accepted · max 10&nbsp;MB per file</p>
  </div>

  <div data-uploads="vault">
    <% if (vaultFiles.length) { %>
    <div class="panel-title" style="margin-top:1rem;">Your documents</div>
    <% vaultFiles.forEach(function(f) { %>
    <div class="row-item" data-file-row="<%= f.id %>">
      <div style="min-width:0;">
        <div class="row-main">📄 <a href="/dashboard/vault/file/<%= f.id %>" style="color:var(--fg);"><%= f.filename %></a>
          <% if (f.has_text) { %><span class="chip chip-accent" style="margin-left:0.35rem;">Readable</span><% } %>
        </div>
        <div class="row-sub"><%= Math.max(1, Math.round(Number(f.size_bytes) / 1024)) %> KB · <%= new Date(f.created_at).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) %></div>
      </div>
      <div style="display:flex; align-items:center; gap:0.4rem; flex-shrink:0;">
        <% if (f.has_text) { %>
        <button class="btn btn-ghost btn-sm" data-extract-file="<%= f.id %>" data-filename="<%= f.filename %>">✨ Extract figures</button>
        <% } %>
        <button class="icon-btn" data-del-file="<%= f.id %>" title="Delete" aria-label="Delete <%= f.filename %>">✕</button>
      </div>
    </div>
    <% }); %>
    <% } %>
  </div>

  <div class="assistant-card" style="margin-top:1.2rem;">
    <div class="avatar">M</div>
    <div style="flex:1;">
      <div style="font-weight:600; font-size:0.95rem;">What is Vault?</div>
      <p style="font-size:0.85rem; color:var(--fg-muted); margin:0.4rem 0 0.8rem; line-height:1.6;">
        Documents you upload become part of Maal's knowledge base, so the education you get reflects your
        actual situation — statements are read and understood, not just stored. Text-based files (PDF, Word,
        CSV) are read by Maal's AI to power answers and figure extraction; their text is processed securely
        and never sold. Scanned or photographed documents aren't readable yet.
      </p>
      <div class="grid-2" style="gap:0.3rem 1.2rem;">
        <div class="check-item done"><span class="check-dot">✓</span> ATO Notices of Assessment</div>
        <div class="check-item done"><span class="check-dot">✓</span> Super fund statements</div>
        <div class="check-item done"><span class="check-dot">✓</span> Bank &amp; brokerage statements</div>
        <div class="check-item done"><span class="check-dot">✓</span> Property contracts or deeds</div>
        <div class="check-item done"><span class="check-dot">✓</span> Income protection &amp; life insurance policies</div>
        <div class="check-item done"><span class="check-dot">✓</span> Trust deeds &amp; wills</div>
      </div>
    </div>
  </div>

</div>
