<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <title>Create account — Mizan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
    .auth-wrap { width: 100%; max-width: 420px; }
    .auth-logo { text-align: center; margin-bottom: 2.5rem; }
    .auth-logo a { text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; }
    .auth-card { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 2.5rem; }
    .auth-card h1 { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; color: var(--fg); margin: 0 0 0.35rem; }
    .auth-card .subtitle { font-size: 0.875rem; color: var(--fg-muted); margin: 0 0 2rem; line-height: 1.55; }
    .form-group { margin-bottom: 1.1rem; }
    .form-group label { display: block; font-size: 0.75rem; font-weight: 500; color: var(--fg-muted); margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.07em; }
    .form-group input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.7rem 0.9rem; color: var(--fg); font-size: 0.9rem; font-family: var(--font-body); outline: none; transition: border-color 0.2s; box-sizing: border-box; }
    .form-group input:focus { border-color: var(--accent); }
    .form-group input::placeholder { color: var(--fg-muted); opacity: 0.5; }
    .btn-primary { width: 100%; background: var(--accent); color: #fff; font-weight: 600; font-size: 0.9rem; padding: 0.8rem 1.5rem; border: none; border-radius: 8px; cursor: pointer; font-family: var(--font-body); transition: opacity 0.2s; }
    .btn-primary:hover { opacity: 0.85; }
    .alert { padding: 0.75rem 0.9rem; border-radius: 8px; font-size: 0.825rem; margin-bottom: 1.1rem; line-height: 1.5; }
    .alert-error { background: var(--danger-soft); border: 1px solid rgba(224,112,112,0.3); color: var(--danger); }
    .terms-note { font-size: 0.75rem; color: var(--fg-muted); line-height: 1.5; margin-top: 0.75rem; text-align: center; }
    .terms-note a { color: var(--accent); text-decoration: none; }
    .auth-footer { text-align: center; margin-top: 1.5rem; font-size: 0.825rem; color: var(--fg-muted); }
    .auth-footer a { color: var(--accent); text-decoration: none; }
    .back-link { display: block; text-align: center; margin-top: 1.5rem; font-size: 0.825rem; color: var(--fg-muted); text-decoration: none; }
    @media (max-width: 480px) { .auth-card { padding: 1.75rem 1.25rem; } }
  </style>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-logo">
      <a href="/">
        <span style="font-size:1.8rem;color:var(--accent);">◈</span>
        <span style="font-family:var(--font-display);font-size:1.3rem;font-weight:600;color:var(--fg);">Mizan</span>
      </a>
    </div>
    <div class="auth-card">
      <h1>Create your account</h1>
      <p class="subtitle">Get your Financial Health Score in minutes.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/signup" method="POST">
        <div class="form-group">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" placeholder="Dr Sarah Chen" required value="<%= name %>">
        </div>
        <div class="form-group">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required value="<%= email %>">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="At least 8 characters" required minlength="8" oninput="checkStrength(this.value)">
          <div id="strengthBar" style="height:3px;border-radius:2px;margin-top:6px;background:var(--surface-3);display:none;">
            <div id="strengthFill" style="height:100%;border-radius:2px;width:0%;transition:width 0.3s,background 0.3s;"></div>
          </div>
          <div id="strengthHint" style="font-size:0.75rem;margin-top:4px;color:var(--fg-muted);display:none;"></div>
        </div>
        <div class="form-group">
          <label for="phone">Mobile number <span style="color:var(--fg-muted);font-weight:400;text-transform:none;">(optional — for SMS verification)</span></label>
          <input type="tel" id="phone" name="phone" placeholder="+61 4xx xxx xxx">
        </div>
        <button type="submit" class="btn-primary">Create account</button>
        <p class="terms-note">By creating an account you agree to our Terms of Service.</p>
      </form>
    </div>
          <div style="margin-top:1.25rem;text-align:center;font-size:0.8rem;color:var(--fg-muted);">— or —</div>
      <a href="/auth/google" style="display:flex;align-items:center;justify-content:center;gap:0.6rem;width:100%;margin-top:1rem;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:0.75rem;font-size:0.9rem;font-weight:500;color:var(--fg);text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='var(--surface-3)'" onmouseout="this.style.background='var(--surface-2)'">
        <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.964 10.707A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.707V4.961H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.039l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.961L3.964 7.293C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
        Continue with Google
      </a>
    <div class="auth-footer">
      Already have an account? <a href="/login">Sign in</a>
    </div>
    <a href="/" class="back-link">← Back to Mizan</a>
  </div>
  <script>
  function checkStrength(val) {
    const bar = document.getElementById('strengthBar');
    const fill = document.getElementById('strengthFill');
    const hint = document.getElementById('strengthHint');
    if (!val) { bar.style.display='none'; hint.style.display='none'; return; }
    bar.style.display='block'; hint.style.display='block';
    let score = 0;
    if (val.length >= 8) score++;
    if (val.length >= 12) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const levels = [
      { w:'20%', bg:'#E07070', label:'Too weak' },
      { w:'40%', bg:'#E07070', label:'Weak' },
      { w:'60%', bg:'#C8963C', label:'Fair' },
      { w:'80%', bg:'#C9A84C', label:'Good' },
      { w:'100%', bg:'#7ED4A6', label:'Strong' },
    ];
    const l = levels[Math.min(score, 4)];
    fill.style.width = l.w; fill.style.background = l.bg;
    hint.style.color = l.bg; hint.textContent = l.label;
    if (!/[A-Z]/.test(val)) hint.textContent += ' — add an uppercase letter';
    else if (!/[0-9]/.test(val)) hint.textContent += ' — add a number';
  }
  </script>
</body>
</html>