<%
  var bqEnabled = typeof basiqEnabled !== 'undefined' && basiqEnabled;
  var bqStatus = typeof basiqStatus !== 'undefined' ? basiqStatus : null;
  var liveTx = typeof liveTransactions !== 'undefined' ? liveTransactions : [];
  var liveAcc = typeof liveAccounts !== 'undefined' ? liveAccounts : [];
%>
<div class="page-head">
  <div>
    <h1>Transactions</h1>
    <div class="sub">Connect your bank and Mizan reads your transactions and subscriptions in near real-time.</div>
  </div>
  <% if (bqEnabled && user.basiq_user_id) { %>
  <a href="/basiq/sync" class="btn btn-ghost btn-sm">↻ Sync now</a>
  <% } %>
</div>

<% if (bqStatus === 'connected' || bqStatus === 'synced') { %>
<div class="alert alert-success">✓ Bank <%= bqStatus %> via Basiq — accounts saved. Transactions appear below as they sync.</div>
<% } else if (bqStatus === 'error') { %>
<div class="alert alert-error">Basiq connection hit a snag<% if (typeof basiqReason !== 'undefined' && basiqReason) { %>: <code style="font-size:0.78rem;"><%= basiqReason %></code><% } %>. Check the BASIQ_API_KEY on the server and try again.</div>
<% } else if (bqStatus === 'nokey') { %>
<div class="alert alert-error">Basiq isn't configured yet — add BASIQ_API_KEY on Render (free sandbox at dashboard.basiq.io). Until then, bank tiles run in demo mode.</div>
<% } else if (bqEnabled && user.basiq_user_id && !liveAcc.length) { %>
<div class="alert alert-success">Finished approving at your bank? Press <a href="/basiq/sync">↻ Sync now</a> to pull your accounts in.</div>
<% } %>

<% if (liveAcc.length) { %>
<div class="panel" style="margin-bottom:1.2rem;">
  <div class="panel-title">Connected accounts <span class="chip chip-accent">Live via Basiq</span>
    <a class="more" href="/dashboard/accounts">Manage →</a>
  </div>
  <% liveAcc.forEach(function(a) { %>
  <div class="row-item">
    <div>
      <div class="row-main"><%= a.name || (a.institution || 'Bank account') %></div>
      <div class="row-sub"><%= (a.accountNo || '') %> <%= a.class && a.class.product ? '· ' + a.class.product : '' %></div>
    </div>
    <div class="row-val">$<%= (Number(a.balance) || 0).toLocaleString('en-AU', { minimumFractionDigits: 2 }) %></div>
  </div>
  <% }); %>
</div>
<% } %>

<% if (liveTx.length) { %>
<div class="panel" style="margin-bottom:1.2rem;">
  <div class="panel-title">Recent transactions <span class="chip chip-accent">Live via Basiq</span></div>
  <table class="table">
    <thead><tr><th>Date</th><th>Description</th><th style="text-align:right;">Amount</th></tr></thead>
    <tbody>
      <% liveTx.forEach(function(t) { %>
      <tr>
        <td style="white-space:nowrap;"><%= (t.postDate || t.transactionDate || '').slice(0, 10) %></td>
        <td><%= t.description || t.subClass && t.subClass.title || '—' %></td>
        <td style="text-align:right; font-weight:600; color:<%= Number(t.amount) < 0 ? 'var(--danger)' : 'var(--accent-strong)' %>;">
          $<%= Math.abs(Number(t.amount) || 0).toLocaleString('en-AU', { minimumFractionDigits: 2 }) %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

<div class="assistant-card" style="margin-bottom:1.2rem;">
  <div class="avatar">M</div>
  <div>
    <div style="font-weight:600; font-size:0.95rem;">How transactions work</div>
    <p style="font-size:0.85rem; color:var(--fg-muted); margin:0.4rem 0 0; line-height:1.6;">
      Connect your bank through Basiq — Australia's Consumer Data Right (open banking) platform — and your
      transactions flow in automatically. Takes a few minutes. Prefer manual? Upload statements below.
    </p>
  </div>
</div>

<div class="widget-grid">
  <div class="panel col-7">
    <div class="panel-title">Connect an account <span class="chip chip-accent"><%= bqEnabled ? 'Basiq sandbox live' : 'Powered by Basiq' %></span></div>
    <div class="field"><input type="search" data-inst-search placeholder="Search institutions…"></div>
    <div class="inst-grid" <%= bqEnabled ? 'data-basiq-live' : '' %>>
      <div class="inst"><span class="inst-logo" style="background:#FFCC00; color:#000;">CBA</span><span class="inst-name">CommBank</span></div>
      <div class="inst"><span class="inst-logo" style="background:#DA1710;">W</span><span class="inst-name">Westpac</span></div>
      <div class="inst"><span class="inst-logo" style="background:#C20000;">NAB</span><span class="inst-name">NAB</span></div>
      <div class="inst"><span class="inst-logo" style="background:#007DBA;">ANZ</span><span class="inst-name">ANZ</span></div>
      <div class="inst"><span class="inst-logo" style="background:#1D252C;">MQ</span><span class="inst-name">Macquarie</span></div>
      <div class="inst"><span class="inst-logo" style="background:#FF6200;">ING</span><span class="inst-name">ING</span></div>
      <div class="inst"><span class="inst-logo" style="background:#FF7A64;">Up</span><span class="inst-name">Up</span></div>
      <div class="inst"><span class="inst-logo" style="background:#0EBB5F;">UB</span><span class="inst-name">UBank</span></div>
      <div class="inst"><span class="inst-logo" style="background:#FFC72C; color:#000;">SUN</span><span class="inst-name">Suncorp</span></div>
    </div>
    <div style="text-align:center; margin:0.9rem 0;">
      <span style="font-size:0.78rem; color:var(--fg-faint);">or</span>
    </div>
    <button class="btn btn-ghost" style="width:100%; justify-content:center;" data-add-asset="investment_portfolio">Add a manual account or credit card</button>
    <p style="font-size:0.72rem; color:var(--fg-faint); margin:1rem 0 0; line-height:1.6;">
      🔒 Your data is secure. Mizan connects read-only via Basiq under the Consumer Data Right. It cannot make
      transactions on your behalf or change your banking. Revoke access anytime — credentials are never stored,
      and your data is never sold.
    </p>
  </div>

  <div class="panel col-5">
    <div class="panel-title">Import manually</div>
    <div class="dropzone" data-dropzone="statements" data-kind="statement" style="padding:2.2rem 1rem;">
      <div style="font-size:1.4rem; margin-bottom:0.4rem;">⇪</div>
      <strong>Upload CSV or PDF</strong>
      <p style="margin:0.4rem 0 0; font-size:0.76rem;">Drag a bank statement here or click to browse · max 10&nbsp;MB</p>
    </div>
    <div data-uploads="statements">
      <% var stmts = (typeof statementFiles !== 'undefined' && statementFiles) ? statementFiles : []; %>
      <% if (stmts.length) { %>
      <div class="panel-title" style="margin-top:1rem;">Uploaded statements</div>
      <% stmts.forEach(function(f) { %>
      <div class="row-item" data-file-row="<%= f.id %>">
        <div style="min-width:0;">
          <div class="row-main">📄 <a href="/dashboard/vault/file/<%= f.id %>" style="color:var(--fg);"><%= f.filename %></a></div>
          <div class="row-sub"><%= Math.max(1, Math.round(Number(f.size_bytes) / 1024)) %> KB · <%= new Date(f.created_at).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) %></div>
        </div>
        <button class="icon-btn" data-del-file="<%= f.id %>" title="Delete">✕</button>
      </div>
      <% }); %>
      <% } %>
    </div>
    <div style="margin-top:1rem; font-size:0.78rem; color:var(--fg-muted); line-height:1.8;">
      <strong style="color:var(--fg);">Supported formats</strong><br>
      CSV — Date, Description, Amount<br>
      PDF — bank statements (auto-parsed)
    </div>
  </div>
</div>
