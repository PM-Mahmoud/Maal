<%
  var radarList = (typeof radars !== 'undefined' && radars) ? radars : [];
  var aiReady = typeof advisorReady !== 'undefined' ? advisorReady : false;
%>
<div class="page-head">
  <div>
    <h1>Radar</h1>
    <div class="sub">Tell Mizan what to watch. It checks on schedule and alerts you by email or SMS.</div>
  </div>
</div>

<% if (!aiReady) { %>
<div class="alert alert-error">Radar needs the AI engine — add your Azure OpenAI keys on the server to switch it on.</div>
<% } %>

<div class="widget-grid">
  <div class="col-8">

    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Your radars <span class="chip chip-muted"><%= radarList.length %></span></div>
      <div id="radar-list">
        <% if (!radarList.length) { %>
        <div class="empty" style="padding:1rem;"><p>No radars yet — create one on the right.</p></div>
        <% } else { %>
        <% radarList.forEach(function(r) { %>
        <div class="row-item" data-radar="<%= r.id %>">
          <div style="min-width:0; flex:1;">
            <div class="row-main"><%= r.prompt %></div>
            <div class="row-sub">
              <%= r.frequency %> ·
              <%= [r.notify_email ? 'email' : null, r.notify_sms ? 'SMS' : null].filter(Boolean).join(' + ') || 'no alerts' %>
              <% if (r.last_run_at) { %> · last checked <%= new Date(r.last_run_at).toLocaleDateString('en-AU', {day:'numeric',month:'short'}) %><% if (r.last_alerted) { %> <span class="chip chip-warn">alerted</span><% } %><% } %>
            </div>
            <% if (r.last_result) { %><div class="row-sub" style="margin-top:0.3rem; white-space:normal; color:var(--fg-muted);"><%= r.last_result %></div><% } %>
          </div>
          <div style="display:flex; gap:0.3rem; flex-shrink:0;">
            <button class="btn btn-ghost btn-sm" data-radar-run="<%= r.id %>" title="Check now">Run</button>
            <button class="icon-btn" data-radar-del="<%= r.id %>" title="Delete">✕</button>
          </div>
        </div>
        <% }); %>
        <% } %>
      </div>
    </div>

    <p style="font-size:0.74rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:var(--fg-faint); margin:0 0 0.6rem;">Quick start — click to use a template</p>

    <div class="panel" style="padding:0.4rem 1.2rem; margin-bottom:1rem;">
      <div class="row-item" data-radar-template="Watch my portfolio for trends and blind spots — flag anything unusual.">
        <div><div class="row-main">Portfolio Insights</div><div class="row-sub">Spot trends and blind spots you'd otherwise miss</div></div>
        <span class="row-val">›</span>
      </div>
      <div class="row-item" data-radar-template="Before EOFY, alert me about tax moves: deductions, super contributions, franking credits.">
        <div><div class="row-main">Tax Strategy</div><div class="row-sub">EOFY moves, deductions and franking credits to keep more of what you earn</div></div>
        <span class="row-val">›</span>
      </div>
      <div class="row-item" data-radar-template="Track RBA rate decisions and tell me how each one affects my property and loans.">
        <div><div class="row-main">Property &amp; Rates</div><div class="row-sub">Track your property, equity, and RBA rate opportunities</div></div>
        <span class="row-val">›</span>
      </div>
      <div class="row-item" data-radar-template="If my monthly spending goes 20% over my average, alert me with the categories driving it.">
        <div><div class="row-main">Cash Flow</div><div class="row-sub">Stay ahead of cash crunches and spending shifts</div></div>
        <span class="row-val">›</span>
      </div>
      <div class="row-item" data-radar-template="If any of my holdings moves more than 10% in a day, tell me what caused it.">
        <div><div class="row-main">Market News</div><div class="row-sub">Know when ASX or global moves affect your holdings</div></div>
        <span class="row-val">›</span>
      </div>
    </div>

    <div class="assistant-card">
      <div class="avatar">M</div>
      <div>
        <div style="font-weight:600; font-size:0.95rem;">What is Radar?</div>
        <p style="font-size:0.85rem; color:var(--fg-muted); margin:0.4rem 0 0; line-height:1.6;">
          Radars are standing watches over anything in your financial life — transactions, portfolio, stocks,
          interest rates, institutions. Example: "If BHP moves more than 10%, tell me what caused it."
        </p>
      </div>
    </div>

  </div>

  <div class="col-4">
    <div class="panel">
      <div class="panel-title">New Radar</div>
      <div class="field">
        <label>What should I analyse?</label>
        <textarea rows="4" id="radar-text" placeholder='e.g. "If my spending on eating out goes 20% over my monthly average, alert me."'></textarea>
      </div>
      <div class="field">
        <label>Notify me</label>
        <div style="display:flex; gap:1.2rem; font-size:0.84rem; color:var(--fg-muted);">
          <label style="display:flex; gap:0.4rem; align-items:center; font-weight:400;"><input type="checkbox" id="radar-email" checked style="width:auto;"> Email</label>
          <label style="display:flex; gap:0.4rem; align-items:center; font-weight:400;"><input type="checkbox" id="radar-sms" style="width:auto;"> SMS</label>
        </div>
      </div>
      <div class="field">
        <label>Frequency</label>
        <div class="tabs" id="radar-freq"><button class="tab active">Daily</button><button class="tab">Weekly</button><button class="tab">Monthly</button></div>
      </div>
      <div class="field">
        <label>Time (AEST)</label>
        <input type="time" id="radar-time" value="09:00">
      </div>
      <button class="btn btn-accent" id="radar-create" style="width:100%; justify-content:center;">Create Radar</button>
    </div>
  </div>
</div>
