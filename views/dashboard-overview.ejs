<%
  // ── helpers / derived data ──────────────────────────────
  function aud(n) {
    n = Number(n) || 0;
    return '$' + n.toLocaleString('en-AU', { maximumFractionDigits: 0 });
  }
  // Number() everywhere — Postgres returns BIGINT columns as strings,
  // and "53000" + 0 concatenates instead of adding.
  var superBal   = Number(profile && profile.super_balance) || 0;
  var investBal  = Number(profile && profile.investment_portfolio) || 0;
  var propertyV  = Number(profile && profile.property_value) || 0;
  var cashBal    = Number(profile && profile.cash_savings) || 0;
  var monthlyExp = Number(profile && profile.monthly_expenses) || 0;
  var hecs       = Number(profile && profile.hecs_balance) || 0;
  var otherDebt  = Number(profile && profile.total_debt) || 0;
  var totalAssets = superBal + investBal + propertyV + cashBal;
  var totalDebts  = hecs + otherDebt;
  var runwayMonths = (cashBal > 0 && monthlyExp > 0) ? Math.round(cashBal / monthlyExp * 10) / 10 : null;
  var netWorth    = totalAssets - totalDebts;
  var hasData     = totalAssets > 0 || totalDebts > 0;

  var wellbeing = financialScore ? Number(financialScore.score_value) : null;
  var firstName = (session.name || session.email || 'there').split(' ')[0];
  var conn = (typeof connected !== 'undefined' && connected) ? connected : { count: 0 };

  // setup checklist
  var steps = [
    { label: 'Create your account', done: true, href: null },
    { label: 'Complete onboarding', done: !!(profile && profile.completed_onboarding), href: '/onboarding' },
    { label: 'Connect a bank via Basiq', done: !!(user && user.basiq_user_id), href: '/dashboard/transactions' },
    { label: 'Add your super fund', done: superBal > 0, href: '/dashboard/assets' },
    { label: 'Add an asset or liability', done: hasData, href: '/dashboard/assets' },
    { label: 'Upload a statement to Vault', done: false, href: '/dashboard/vault' },
    { label: 'Set your first goal', done: false, href: '/dashboard/goals' },
  ];
  var doneCount = steps.filter(function(s){ return s.done; }).length;
  var pct = Math.round(doneCount / steps.length * 100);
%>

<script>
  // Real balance history for the charts (daily snapshots from the database)
  window.MAAL_SNAPSHOTS = <%- JSON.stringify((typeof snapshots !== 'undefined' && snapshots ? snapshots : []).map(function(s) {
    return { d: s.snap_date, nw: Number(s.net_worth), inv: Number(s.invest_balance), sup: Number(s.super_balance), debt: Number(s.debts_total), cash: Number(s.cash_balance) };
  })) %>;
  // Signed transactions for in/out cash-flow on the tile trend view
  window.MAAL_TXNS = <%- JSON.stringify((typeof chartTxns !== 'undefined' && chartTxns ? chartTxns : []).map(function(t) {
    return { d: t.post_date, amt: Number(t.amount) };
  })) %>;
</script>

<div class="page-head">
  <div>
    <h1>Welcome, <%= firstName %></h1>
    <div class="sub">Your money, in balance — here's where things stand.</div>
  </div>
  <div class="page-head-actions">
    <div class="tabs" id="range-tabs">
      <button class="tab active">1M</button><button class="tab">3M</button><button class="tab">1Y</button><button class="tab">All</button>
    </div>
    <button class="btn btn-accent" data-add-asset="investment_portfolio">Add +</button>
  </div>
</div>

<!-- ── headline stats (click a tile to expand its trend) ── -->
<div class="stat-grid">
  <div class="panel stat-card" data-trend="networth" data-trend-label="Net Worth" tabindex="0" role="button" title="View trend">
    <div class="stat-label">Net Worth <span class="chip chip-muted range-chip">1M</span></div>
    <div class="stat-value"><%= aud(netWorth) %></div>
    <div class="stat-delta <%= hasData ? 'up' : '' %>" data-delta="networth"><%= hasData ? (conn.count ? 'Manual entries + live balances' : 'Tracked daily from your data') : 'Add assets to start tracking' %></div>
    <svg class="sparkline" id="spark-networth" viewBox="0 0 200 36" preserveAspectRatio="none"><path class="fill" d=""/><path class="line" d=""/></svg>
  </div>
  <div class="panel stat-card" data-trend="invest" data-trend-label="Investments" tabindex="0" role="button" title="View trend">
    <div class="stat-label">Investments <span class="chip chip-muted range-chip">1M</span>
      <button class="tile-edit-btn" data-edit-asset="investment_portfolio" data-edit-value="<%= investBal %>" title="Edit" onclick="event.stopPropagation()">✎</button>
      <% if (investBal > 0) { %><button class="tile-edit-btn tile-edit-btn--remove" data-remove-asset="investment_portfolio" title="Clear" onclick="event.stopPropagation()">✕</button><% } %>
    </div>
    <div class="stat-value"><%= aud(investBal) %></div>
    <div class="stat-delta" data-delta="invest"><%= investBal > 0 ? 'Across your portfolios' : 'No investments added yet' %></div>
    <svg class="sparkline" id="spark-invest" viewBox="0 0 200 36" preserveAspectRatio="none"><path class="fill" d=""/><path class="line" d=""/></svg>
  </div>
  <div class="panel stat-card" data-trend="cash" data-trend-label="Total Cash" tabindex="0" role="button" title="View trend">
    <div class="stat-label">Total Cash <span class="chip chip-accent"><%= conn.count ? '● ' + conn.count + ' live' : 'Liquidity' %></span>
      <button class="tile-edit-btn" data-edit-asset="cash_savings" data-edit-value="<%= cashBal %>" title="Edit" onclick="event.stopPropagation()">✎</button>
      <% if (cashBal > 0) { %><button class="tile-edit-btn tile-edit-btn--remove" data-remove-asset="cash_savings" title="Clear" onclick="event.stopPropagation()">✕</button><% } %>
    </div>
    <div class="stat-value"><%= aud(cashBal) %></div>
    <div class="stat-delta" data-delta="cash"><%= cashBal > 0 ? (runwayMonths ? runwayMonths + ' months of runway' : 'Set monthly spend for runway') : 'Add cash & savings' %></div>
    <svg class="sparkline" id="spark-cash" viewBox="0 0 200 36" preserveAspectRatio="none"><path class="fill" d=""/><path class="line" d=""/></svg>
  </div>
  <div class="panel stat-card" data-trend="debts" data-trend-label="Total Debts" tabindex="0" role="button" title="View trend">
    <div class="stat-label">Total Debts <span class="chip chip-muted">incl. HECS</span>
      <button class="tile-edit-btn" data-edit-asset="hecs_balance" data-edit-value="<%= hecs %>" title="Edit HECS" onclick="event.stopPropagation()">✎</button>
      <% if (totalDebts > 0) { %><button class="tile-edit-btn tile-edit-btn--remove" data-remove-asset="hecs_balance" title="Clear HECS" onclick="event.stopPropagation()">✕</button><% } %>
    </div>
    <div class="stat-value"><%= aud(totalDebts) %></div>
    <div class="stat-delta" data-delta="debts"><%= totalDebts > 0 ? 'HECS indexation applies 1 June' : 'No liabilities recorded' %></div>
    <svg class="sparkline" id="spark-debts" viewBox="0 0 200 36" preserveAspectRatio="none"><path class="fill" d=""/><path class="line" d=""/></svg>
  </div>
</div>

<% if (conn.count) { %>
<div style="font-size:0.74rem; color:var(--fg-faint); margin:-0.3rem 0 0.6rem; line-height:1.6;">
  Totals combine your manual entries with <%= conn.count %> live account<%= conn.count > 1 ? 's' : '' %> via Basiq.
  Entered an account that's now connected? <a href="/dashboard/assets" style="color:var(--accent);">Clear its manual figure</a> so it isn't counted twice.
</div>
<% } %>

<!-- ── The Maal Score (single composite wellbeing score) ── -->
<%
  var mz = (typeof maalScore !== 'undefined' && maalScore) ? maalScore : { score: 0, band: '—', pillars: [], hasData: false };
  var bandChip = mz.score >= 65 ? 'chip-accent' : mz.score >= 50 ? 'chip-gold' : mz.score >= 35 ? 'chip-warn' : 'chip-danger';
%>
<div class="panel panel-hero" style="margin: 1rem 0; padding: 1.5rem 1.6rem;">
  <div class="widget-grid" style="align-items:center;">
    <div class="col-4" style="display:flex; align-items:center; gap:1.3rem;">
      <svg class="ring" viewBox="0 0 100 100" style="width:110px; height:110px;">
        <circle class="track" cx="50" cy="50" r="42"/>
        <circle class="meter <%= mz.score < 50 && mz.hasData ? 'warn' : '' %>" cx="50" cy="50" r="42" stroke-dasharray="<%= Math.round((mz.hasData ? mz.score : 0)/100*264) %> 264"/>
        <text class="ring-num" x="50" y="47" text-anchor="middle" dominant-baseline="central" style="font-size:1.5rem;"><%= mz.hasData ? mz.score : '—' %></text>
        <text class="ring-sub" x="50" y="68" text-anchor="middle">of 100</text>
      </svg>
      <div>
        <div class="score-name" style="font-size:1.05rem;">Maal Score <% if (mz.hasData) { %><span class="chip <%= bandChip %>"><%= mz.band %></span><% } %></div>
        <div class="score-desc" style="margin-top:0.3rem;">
          <%= mz.hasData
              ? 'Your financial wellbeing in one number — savings, debt, super, wealth and protection, weighted the way researchers measure financial health.'
              : 'Add your income, assets and debts and your score appears instantly.' %>
        </div>
        <% if (!mz.hasData) { %>
        <button class="btn btn-accent btn-sm" style="margin-top:0.7rem;" data-add-asset="investment_portfolio">Build my score</button>
        <% } %>
      </div>
    </div>
    <div class="col-8">
      <% mz.pillars.forEach(function(pl) { %>
      <div class="row-item" style="padding:0.45rem 0;">
        <div style="flex:1;">
          <div class="row-main" style="display:flex; justify-content:space-between;">
            <span><%= pl.label %> <span style="color:var(--fg-faint); font-weight:400; font-size:0.72rem;"><%= Math.round(pl.weight*100) %>%</span></span>
            <span><%= mz.hasData ? pl.score : '—' %></span>
          </div>
          <div class="bar-track"><div class="bar-fill <%= pl.score < 40 ? '' : '' %>" style="width:<%= mz.hasData ? pl.score : 0 %>%; <%= pl.score < 40 ? 'background:var(--warn);' : '' %>"></div></div>
          <div class="row-sub" style="margin-top:0.2rem;"><%= pl.note %></div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>

<!-- ── widget grid ── -->
<div class="widget-grid">

  <div class="panel col-4">
    <div class="panel-title">Setup — <%= pct %>% complete <span class="progress-ring-label"><%= doneCount %>/<%= steps.length %></span></div>
    <% steps.forEach(function(s) { %>
      <div class="check-item <%= s.done ? 'done' : '' %>">
        <span class="check-dot"><%= s.done ? '✓' : '' %></span>
        <% if (s.href && !s.done) { %><a href="<%= s.href %>" style="color:inherit;"><%= s.label %></a><% } else { %><%= s.label %><% } %>
      </div>
    <% }); %>
  </div>

  <div class="panel col-4" style="background: linear-gradient(150deg, var(--accent-softer), var(--surface)); ">
    <div class="panel-title">Ask Maal <a class="more" href="/dashboard/ask">Open →</a></div>
    <p style="font-size:0.83rem; color:var(--fg-muted); margin:0 0 0.8rem;">Your CFO-level second opinion. Ask anything about your finances.</p>
    <div class="suggest-grid" style="grid-template-columns:1fr;">
      <button class="suggest" onclick="location.href='/dashboard/ask'">How did my net worth change this month?</button>
      <button class="suggest" onclick="location.href='/dashboard/ask'">Is my super on track for retirement at 60?</button>
      <button class="suggest" onclick="location.href='/dashboard/ask'">Should I salary sacrifice more into super?</button>
      <button class="suggest" onclick="location.href='/dashboard/ask'">What were my top 3 expenses this month?</button>
    </div>
  </div>

  <div class="panel col-4">
    <div class="panel-title">Radar <a class="more" href="/dashboard/radar">Explore →</a></div>
    <div class="empty">
      <h3>Set up your first radar</h3>
      <p>Tell Maal what to watch — your spending, the ASX, rate moves — and get alerted by email or SMS.</p>
      <a href="/dashboard/radar" class="btn btn-ghost btn-sm">Explore Radar</a>
    </div>
  </div>

  <div class="panel col-4">
    <div class="panel-title">Assets <span class="more"><%= aud(totalAssets) %></span></div>
    <% if (totalAssets > 0) { %>
      <% if (superBal > 0) { %>
      <div class="row-item"><div><div class="row-main">Superannuation</div><div class="bar-track" style="width:140px;"><div class="bar-fill" style="width:<%= Math.round(superBal/totalAssets*100) %>%;"></div></div></div><div class="row-val"><%= aud(superBal) %></div></div>
      <% } %>
      <% if (investBal > 0) { %>
      <div class="row-item"><div><div class="row-main">Investments</div><div class="bar-track" style="width:140px;"><div class="bar-fill" style="width:<%= Math.round(investBal/totalAssets*100) %>%;"></div></div></div><div class="row-val"><%= aud(investBal) %></div></div>
      <% } %>
      <% if (propertyV > 0) { %>
      <div class="row-item"><div><div class="row-main">Property</div><div class="bar-track" style="width:140px;"><div class="bar-fill" style="width:<%= Math.round(propertyV/totalAssets*100) %>%;"></div></div></div><div class="row-val"><%= aud(propertyV) %></div></div>
      <% } %>
    <% } else { %>
      <div class="empty"><h3>No assets yet</h3><p>Add your super, savings, shares or property.</p><button class="btn btn-accent btn-sm" data-add-asset="investment_portfolio">+ Add Asset</button></div>
    <% } %>
  </div>

  <div class="panel col-4">
    <div class="panel-title">Liabilities <span class="more"><%= aud(totalDebts) %></span></div>
    <% if (totalDebts > 0) { %>
      <% if (hecs > 0) { %>
      <div class="row-item"><div class="row-main">HECS-HELP</div><div class="row-val"><%= aud(hecs) %></div></div>
      <% } %>
      <% if (otherDebt > 0) { %>
      <div class="row-item"><div class="row-main">Other debt</div><div class="row-val"><%= aud(otherDebt) %></div></div>
      <% } %>
    <% } else { %>
      <div class="empty"><h3>No liabilities</h3><p>Track HECS, mortgages, cards and loans here.</p><button class="btn btn-danger-soft btn-sm" data-add-asset="hecs_balance">+ Add Liability</button></div>
    <% } %>
  </div>

  <div class="panel col-4">
    <div class="panel-title">Market Summary <span class="chip chip-muted">ASX</span></div>
    <div class="row-item"><div class="row-main">S&amp;P/ASX 200</div><div class="row-val" style="color:var(--accent-strong);">+0.6%</div></div>
    <div class="row-item"><div class="row-main">AUD/USD</div><div class="row-val">0.67</div></div>
    <div class="row-item"><div class="row-main">RBA Cash Rate</div><div class="row-val">3.85%</div></div>
    <p style="font-size:0.78rem; color:var(--fg-muted); margin:0.7rem 0 0; line-height:1.6;">
      Markets steadied as the RBA held rates and miners lifted the ASX. Connect your portfolio to see how moves affect your holdings.
    </p>
  </div>

  <%
    var tax = (typeof taxImpact !== 'undefined' && taxImpact) ? taxImpact : { hasData: false };
  %>
  <div class="panel col-6">
    <div class="panel-title">Tax Impact <span class="chip chip-muted">FY25–26 estimate</span></div>
    <% if (tax.hasData) { %>
    <div class="row-item"><div class="row-main">Income tax</div><div class="row-val"><%= aud(tax.incomeTax) %></div></div>
    <div class="row-item"><div class="row-main">Medicare levy</div><div class="row-val"><%= aud(tax.medicare) %></div></div>
    <% if (tax.hecs > 0) { %>
    <div class="row-item"><div class="row-main">HECS repayment</div><div class="row-val"><%= aud(tax.hecs) %></div></div>
    <% } %>
    <div class="row-item"><div><div class="row-main">Take-home pay</div><div class="row-sub"><%= tax.effectiveRate %>% effective · <%= tax.marginalRate %>% marginal</div></div><div class="row-val" style="color:var(--accent-strong);"><%= aud(tax.takeHomeMonthly) %>/mo</div></div>
    <p style="font-size:0.72rem; color:var(--fg-faint); margin:0.7rem 0 0; line-height:1.6;">
      Indicative only — excludes deductions, offsets and salary packaging. Ask Maal to explore strategies.
    </p>
    <% } else { %>
    <div class="empty"><h3>Add your income</h3><p>Set your annual income and Maal estimates tax, Medicare and HECS withholding instantly.</p><a href="/dashboard/profile" class="btn btn-ghost btn-sm">Complete profile</a></div>
    <% } %>
  </div>

  <% var mv = (typeof movers !== 'undefined' && movers) ? movers : null; %>
  <div class="panel col-6">
    <div class="panel-title">Top &amp; Bottom Movers <span class="chip <%= mv ? 'chip-accent' : 'chip-muted' %>"><%= mv ? '● Live' : 'Watchlist' %></span></div>
    <% if (mv) { %>
      <% mv.top.forEach(function(q) { var pct = Number(q.percent) || 0; %>
      <div class="row-item">
        <div><div class="row-main"><%= q.symbol %></div><div class="row-sub">$<%= (Number(q.price)||0).toLocaleString('en-AU', { minimumFractionDigits: 2 }) %></div></div>
        <div class="row-val" style="color:var(--accent);">▲ <%= pct.toFixed(2) %>%</div>
      </div>
      <% }); %>
      <% mv.bottom.forEach(function(q) { var pct = Number(q.percent) || 0; if (pct >= 0) return; %>
      <div class="row-item">
        <div><div class="row-main"><%= q.symbol %></div><div class="row-sub">$<%= (Number(q.price)||0).toLocaleString('en-AU', { minimumFractionDigits: 2 }) %></div></div>
        <div class="row-val" style="color:var(--danger);">▼ <%= Math.abs(pct).toFixed(2) %>%</div>
      </div>
      <% }); %>
      <p style="font-size:0.7rem; color:var(--fg-faint); margin:0.6rem 0 0;">Live via Finnhub · default watchlist (set MAAL_WATCHLIST to customise).</p>
    <% } else { %>
    <div class="empty">
      <h3>Connect live market data</h3>
      <p>Add a free Finnhub API key (FINNHUB_API_KEY) and Maal surfaces the day's biggest movers on your watchlist here.</p>
      <a href="/dashboard/research" class="btn btn-ghost btn-sm">Explore Research</a>
    </div>
    <% } %>
  </div>

  <%
    var recentTx = (typeof recentTransactions !== 'undefined' && recentTransactions) ? recentTransactions : [];
  %>
  <div class="panel col-6">
    <div class="panel-title">Recent Transactions <a class="more" href="/dashboard/transactions">View all →</a></div>
    <% if (recentTx.length) { %>
      <% recentTx.forEach(function(t) {
           var d = t.post_date ? new Date(t.post_date) : null;
           var amt = Number(t.amount) || 0;
      %>
      <div class="row-item">
        <div>
          <div class="row-main"><%= t.description || '—' %></div>
          <div class="row-sub"><%= d ? d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) : '' %></div>
        </div>
        <div class="row-val" style="color:<%= amt < 0 ? 'var(--danger)' : 'var(--accent)' %>;">
          <%= (amt < 0 ? '−' : '+') + '$' + Math.abs(amt).toLocaleString('en-AU', { minimumFractionDigits: 2 }) %>
        </div>
      </div>
      <% }); %>
    <% } else { %>
    <div class="empty">
      <h3>No transactions yet</h3>
      <p>Connect your bank securely via Basiq (Consumer Data Right), then press Sync — your spending appears here.</p>
      <a href="/dashboard/transactions" class="btn btn-accent btn-sm">Connect with Basiq</a>
    </div>
    <% } %>
  </div>

  <div class="panel col-3">
    <div class="panel-title">Cash Runway</div>
    <div style="text-align:center; padding:0.6rem 0;">
      <div style="font-size:2.2rem; font-weight:800;"><%= runwayMonths !== null ? runwayMonths : '—' %></div>
      <div style="font-size:0.78rem; color:var(--fg-muted);">months</div>
    </div>
    <div class="row-item"><div class="row-sub">Monthly burn</div><div class="row-val" data-add-asset="monthly_expenses" title="Click to set"><%= monthlyExp > 0 ? aud(monthlyExp) : 'Set' %></div></div>
    <div class="row-item"><div class="row-sub">Cash on hand</div><div class="row-val" data-add-asset="cash_savings" title="Click to set"><%= cashBal > 0 ? aud(cashBal) : 'Set' %></div></div>
  </div>

  <div class="panel col-3">
    <div class="panel-title">Key Dates <span class="chip chip-accent">AU</span></div>
    <div class="row-item"><div><div class="row-main">EOFY</div><div class="row-sub">Tax year ends</div></div><div class="row-val">30 Jun</div></div>
    <div class="row-item"><div><div class="row-main">HECS indexation</div><div class="row-sub">Applied to balances</div></div><div class="row-val">1 Jun</div></div>
    <div class="row-item"><div><div class="row-main">Super guarantee</div><div class="row-sub">Employer rate</div></div><div class="row-val">12%</div></div>
  </div>

</div>
