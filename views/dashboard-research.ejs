<%
  var reportList = (typeof reports !== 'undefined' && reports) ? reports : [];
  var aiReady = typeof advisorReady !== 'undefined' ? advisorReady : false;
  function when(d) { try { return new Date(d).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }); } catch (e) { return ''; } }
%>
<div class="page-head">
  <div>
    <h1>Research</h1>
    <div class="sub">Ask anything. Mizan grounds the answer in live market data and web research, then explains it.</div>
  </div>
</div>

<% if (!aiReady) { %>
<div class="alert alert-error">Research needs the AI engine — add your Azure OpenAI keys on the server to switch it on.</div>
<% } %>

<div class="widget-grid">
  <div class="col-8">

    <div class="composer">
      <textarea id="research-input" placeholder="What happens to my borrowing power if the RBA cuts rates 0.5%?"></textarea>
      <div class="composer-bar">
        <span style="font-size:0.75rem; color:var(--fg-faint);">Grounded in live data · education only</span>
        <button class="send-btn" id="research-run" title="Run research">↑</button>
      </div>
    </div>

    <!-- Report renders here -->
    <div id="research-report" class="panel" style="margin-top:1rem; display:none;">
      <div class="panel-title">Report <span class="chip chip-accent" id="research-report-status">Ready</span></div>
      <div id="research-report-q" style="font-weight:600; font-size:0.92rem; margin-bottom:0.6rem;"></div>
      <div id="research-report-body" style="font-size:0.9rem; line-height:1.7; color:var(--fg); white-space:pre-wrap;"></div>
      <div id="research-report-sources" style="margin-top:1rem;"></div>
    </div>

    <p style="text-align:center; font-size:0.8rem; color:var(--fg-muted); margin:1.4rem 0 0.7rem;">Try research like…</p>
    <div class="suggest-grid">
      <button class="suggest" data-research-suggest>What if the ASX drops 20% next quarter — how exposed am I?</button>
      <button class="suggest" data-research-suggest>Compare salary sacrifice vs extra mortgage repayments for me</button>
      <button class="suggest" data-research-suggest>What's the latest news affecting Australian bank shares?</button>
      <button class="suggest" data-research-suggest>Project my net worth if I save an extra $500/month</button>
      <button class="suggest" data-research-suggest>How would a 1% HECS indexation change affect my balance?</button>
      <button class="suggest" data-research-suggest>What are my biggest financial risks right now?</button>
    </div>

    <div class="assistant-card" style="margin-top:1.4rem;">
      <div class="avatar">M</div>
      <div>
        <div style="font-weight:600; font-size:0.95rem;">How Research works</div>
        <p style="font-size:0.85rem; color:var(--fg-muted); margin:0.4rem 0 0; line-height:1.6;">
          Ask a question and Mizan pulls live market data and recent news, reads them against your profile,
          and writes a grounded report with sources — in seconds. Education only, never personal advice.
        </p>
      </div>
    </div>

  </div>

  <div class="col-4">
    <div class="panel">
      <div class="panel-title">Research history</div>
      <div id="research-history">
        <% if (!reportList.length) { %>
        <div class="empty" style="padding:1.2rem 0.5rem;"><p>No research yet. Your reports will appear here.</p></div>
        <% } else { %>
        <% reportList.forEach(function(r) { %>
        <div class="row-item" data-report-id="<%= r.id %>" style="cursor:pointer;">
          <div style="min-width:0;">
            <div class="row-main" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= r.question %></div>
            <div class="row-sub"><%= when(r.created_at) %></div>
          </div>
          <span class="chip <%= r.status === 'complete' ? 'chip-accent' : r.status === 'error' ? 'chip-danger' : 'chip-muted' %>"><%= r.status %></span>
        </div>
        <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>
