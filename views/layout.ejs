<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta property="og:title" content="Maal — Financial clarity for every Australian">
  <meta property="og:description" content="Maal reads your assets, debts, super, and income to deliver a 0–100 Financial Health Score and a personalised action plan. CFO-level clarity, no advisor required.">
  <meta property="og:image" content="https://hellomaal.com/images/og.png">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://hellomaal.com/images/og.png">
  <title>Maal — Financial clarity for every Australian</title>
  <meta name="description" content="Maal reads your assets, debts, super, and income to deliver a 0–100 Financial Health Score and a personalised action plan. CFO-level clarity, no advisor required.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>
  <%- include('partials/navbar') %>
  <%- include('partials/hero') %>
  <%- include('partials/proof') %>
  <%- include('partials/features') %>
  <%- include('partials/how') %>
  <%- include('partials/sectors') %>
  <%- include('partials/waitlist') %>
  <%- include('partials/closing') %>
  <%- include('partials/footer') %>
  <%- analyticsSnippet %>
  <script>
    (function() {
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('is-visible'); });
        return;
      }
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });
    })();
  </script>
</body>
</html>
