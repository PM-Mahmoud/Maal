<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <title>Sign in — Maal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { background: var(--bg); min-height: 100vh; display: flex; flex-direction: column; }
    .auth-header { position: sticky; top: 3px; z-index: 40; background: rgba(251,251,251,.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
    .auth-header-inner { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; height: 64px; display: flex; align-items: center; justify-content: space-between; }
    .auth-wordmark { display: flex; align-items: center; gap: .5rem; text-decoration: none; color: var(--fg); }
    .auth-wordmark-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); }
    .auth-wordmark-text { font-size: 17px; font-weight: 700; letter-spacing: -.03em; }
    .auth-main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 4rem 1.5rem; }
    .auth-box { width: 100%; max-width: 400px; }
    .auth-kicker { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .18em; color: var(--fg-muted); margin-bottom: .75rem; }
    .auth-h1 { font-size: 32px; font-weight: 700; letter-spacing: -.03em; line-height: 1.1; margin-bottom: 2rem; }
    .auth-google { display: flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; height: 44px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); font-size: 13px; font-weight: 600; color: var(--fg); text-decoration: none; transition: background .15s; cursor: pointer; }
    .auth-google:hover { background: var(--surface-2); }
    .auth-divider { display: flex; align-items: center; gap: .75rem; margin: 1.5rem 0; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .18em; color: var(--fg-muted); }
    .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .auth-form { display: flex; flex-direction: column; gap: .75rem; }
    .auth-input { width: 100%; height: 44px; padding: 0 .875rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); font-size: 14px; font-family: var(--font-body); color: var(--fg); outline: none; box-sizing: border-box; transition: border-color .15s; }
    .auth-input:focus { border-color: var(--fg); }
    .auth-input::placeholder { color: var(--fg-muted); }
    .auth-submit { width: 100%; height: 44px; border-radius: 8px; background: var(--fg); color: #fff; font-size: 13px; font-weight: 600; border: none; cursor: pointer; font-family: var(--font-body); transition: opacity .15s; }
    .auth-submit:hover { opacity: .88; }
    .auth-toggle { margin-top: 1.5rem; text-align: center; font-size: 12px; color: var(--fg-muted); }
    .auth-toggle a { color: var(--fg); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    .auth-forgot { text-align: right; font-size: 12px; }
    .auth-forgot a { color: var(--fg-muted); text-decoration: none; }
    .auth-forgot a:hover { color: var(--fg); }
    .auth-alert { padding: .625rem .875rem; background: #fbe7e7; border: 1px solid rgba(220,38,38,.2); border-radius: 8px; font-size: 12px; color: #dc2626; margin-bottom: .75rem; }
    .auth-disclaimer { margin-top: 3rem; font-size: 11px; color: var(--fg-muted); line-height: 1.7; }
  </style>
</head>
<body>
  <header class="auth-header">
    <div class="auth-header-inner">
      <a href="/" class="auth-wordmark">
        <span class="auth-wordmark-dot"></span>
        <span class="auth-wordmark-text">Maal</span>
      </a>
    </div>
  </header>
  <main class="auth-main">
    <div class="auth-box">
      <p class="auth-kicker">Welcome back</p>
      <h1 class="auth-h1">Sign in to Maal.</h1>

      <a href="/auth/google" class="auth-google">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.75h3.57c2.08-1.92 3.28-4.74 3.28-8.07z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.75c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.12c-.22-.66-.35-1.36-.35-2.12s.13-1.46.35-2.12V7.04H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.96l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.04l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
        </svg>
        Continue with Google
      </a>

      <div class="auth-divider">or</div>

      <% if (error) { %><div class="auth-alert"><%= error %></div><% } %>

      <form action="/login" method="POST" class="auth-form">
        <input class="auth-input" type="email" name="email" placeholder="you@example.com" autocomplete="email" required value="<%= email %>">
        <input class="auth-input" type="password" name="password" placeholder="Password (min 6 characters)" autocomplete="current-password" required>
        <div class="auth-forgot"><a href="/forgot-password">Forgot password?</a></div>
        <button type="submit" class="auth-submit">Sign in</button>
      </form>

      <p class="auth-toggle">
        Don't have an account? <a href="/signup">Sign up</a>
      </p>

      <div class="auth-disclaimer">
        Maal does not provide financial advice. Any information is for educational purposes only.
      </div>
    </div>
  </main>
</body>
</html>
