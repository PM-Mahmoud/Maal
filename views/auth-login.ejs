<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <title>Sign in — Maal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/retro.css">
  <style>
    /* auth-only extras layered on the retro theme */
    .rf-alert { padding: .7rem .9rem; background: var(--rf-orange); color: var(--rf-cream); border: 2px solid var(--rf-ink); border-radius: 10px; font-size: 13px; font-weight: 600; margin-bottom: .85rem; }
    .rf-notice { padding: .7rem .9rem; background: var(--rf-gold); color: var(--rf-ink); border: 2px solid var(--rf-ink); border-radius: 10px; font-size: 13px; font-weight: 600; margin-bottom: .85rem; }
    .rf-forgot { text-align: right; font-size: 12.5px; }
    .rf-forgot a { color: var(--rf-muted); text-decoration: none; }
    .rf-forgot a:hover { color: var(--rf-ink); }
    .rf-switch { margin-top: 1rem; text-align: center; font-size: 12.5px; }
    .rf-switch button { background: none; border: none; padding: 0; font: inherit; color: var(--rf-muted); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
    .rf-switch button:hover { color: var(--rf-ink); }
    .rf-auth-disclaimer { margin-top: 2.5rem; font-size: 11.5px; color: var(--rf-muted); line-height: 1.7; }
    [data-method] { display: none; }
    [data-method].active { display: flex; }
    html[data-theme="dark"] .maal-mark .mm-a{fill:#E2C06A}html[data-theme="dark"] .maal-mark .mm-b{fill:#1A4D2E}
  </style>
</head>
<body>
  <div class="rf-auth">
    <div class="rf-auth-form">
      <div class="rf-auth-head">
        <a href="/" class="rf-wordmark">
          <span class="rf-wordmark-badge"><svg class="maal-mark" width="14" height="14" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><g class="mm-a" fill="#C9A84C"><rect x="0" y="0" width="1" height="7"/><rect x="6" y="0" width="1" height="7"/><rect x="1" y="1" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/></g><g class="mm-b" fill="#0A2918"><rect x="2" y="2" width="1" height="1"/><rect x="3" y="3" width="1" height="1"/><rect x="4" y="2" width="1" height="1"/></g></svg></span>
          <span class="rf-wordmark-text">Maal</span>
        </a>
      </div>
      <div class="rf-auth-inner">
        <div class="rf-auth-box">
          <span class="rf-eyebrow">Welcome back</span>
          <h1 class="rf-auth-h1">Sign in to Maal.</h1>

          <a href="/auth/google" class="rf-auth-google">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.75h3.57c2.08-1.92 3.28-4.74 3.28-8.07z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.75c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.12c-.22-.66-.35-1.36-.35-2.12s.13-1.46.35-2.12V7.04H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.96l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.04l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
            </svg>
            Continue with Google
          </a>

          <div class="rf-auth-divider">or</div>

          <% if (error) { %><div class="rf-alert"><%= error %></div><% } %>
          <% if (locals.notice) { %><div class="rf-notice"><%= notice %></div><% } %>

          <form action="/login/email-code" method="POST" class="rf-auth-form-el active" data-method="email">
            <input class="rf-input" type="email" name="email" placeholder="you@example.com" autocomplete="email" required value="<%= email %>">
            <button type="submit" class="rf-btn rf-btn-block rf-btn-lg">Continue with email</button>
          </form>

          <form action="/login" method="POST" class="rf-auth-form-el" data-method="password">
            <input class="rf-input" type="email" name="email" placeholder="you@example.com" autocomplete="email" required value="<%= email %>">
            <input class="rf-input" type="password" name="password" placeholder="Password" autocomplete="current-password" required>
            <div class="rf-forgot"><a href="/forgot-password">Forgot password?</a></div>
            <button type="submit" class="rf-btn rf-btn-block rf-btn-lg">Sign in</button>
          </form>

          <p class="rf-switch">
            <button type="button" id="method-toggle" onclick="toggleMethod()">Sign in with password instead</button>
          </p>

          <p class="rf-auth-toggle">Don't have an account? <a href="/signup">Sign up</a></p>

          <div class="rf-auth-disclaimer">
            Maal does not provide financial advice. Any information is for educational purposes only.
          </div>
        </div>
      </div>
    </div>

    <div class="rf-auth-side">
      <svg class="rf-star-deco one" style="top:8%;right:8%;color:var(--rf-gold);" viewBox="0 0 100 100" fill="currentColor"><path d="M50 0l9 34 34-9-25 25 25 25-34-9-9 34-9-34-34 9 25-25L7 25l34 9z"/></svg>
      <span class="rf-eyebrow" style="color:var(--rf-gold);">Security</span>
      <h2 class="rf-trust-h2">Privacy first, by design.</h2>
      <ul class="rf-trust-list">
        <li class="rf-trust-item">
          <span class="rf-trust-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <span><span class="rf-trust-t">Bank-level encryption</span><span class="rf-trust-s">Security and confidentiality are built into every layer, from the connection to your bank down to how data is stored.</span></span>
        </li>
        <li class="rf-trust-item">
          <span class="rf-trust-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6z"/></svg></span>
          <span><span class="rf-trust-t">Your data, your control</span><span class="rf-trust-s">You choose what to connect, and you can delete it at any time.</span></span>
        </li>
        <li class="rf-trust-item">
          <span class="rf-trust-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/></svg></span>
          <span><span class="rf-trust-t">Always anonymised</span><span class="rf-trust-s">Your identity is separated from your data, so even our own team can't connect the two.</span></span>
        </li>
        <li class="rf-trust-item">
          <span class="rf-trust-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 12 2 2 4-4"/><path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6z"/></svg></span>
          <span><span class="rf-trust-t">CDR-accredited</span><span class="rf-trust-s">Connections run through Basiq, an Australian Consumer Data Right accredited data recipient.</span></span>
        </li>
      </ul>
    </div>
  </div>

  <script>
    function toggleMethod() {
      const email = document.querySelector('[data-method="email"]');
      const pass = document.querySelector('[data-method="password"]');
      const btn = document.getElementById('method-toggle');
      const usingPassword = pass.classList.contains('active');
      email.classList.toggle('active', usingPassword);
      pass.classList.toggle('active', !usingPassword);
      btn.textContent = usingPassword ? 'Sign in with password instead' : 'Continue with email code instead';
    }
  </script>
</body>
</html>
