<%
  // Sign in — v2 (Figma "Logging in"). Same split as the sign-up page:
  // form card on the left, Maal's night-sky panel on the right.
  // Locals: error, notice, email, next (safe same-site path or '').
  const next = locals.next || '';
  const loginAction = next ? '/login?next=' + encodeURIComponent(next) : '/login';
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/v2-head', { title: 'Sign in' }) %>
</head>
<body class="v2">
  <main class="v2-auth">
    <section class="v2-auth-card">
      <div class="v2-auth-inner">
        <a href="/" class="v2-auth-logo" aria-label="Maal home">
          <%- include('partials/v2-mark', { size: 18 }) %>
          <span>Maal</span>
        </a>
        <h1>Welcome back</h1>

        <% if (locals.notice) { %><div class="v2-note v2-note-ok" role="status"><%= notice %></div><% } %>
        <% if (locals.error) { %><div class="v2-alert" role="alert"><%= error %></div><% } %>

        <div class="v2-social">
          <a href="/auth/google" class="v2-btn v2-btn-line">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.75h3.57c2.08-1.92 3.28-4.74 3.28-8.07z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.75c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.12c-.22-.66-.35-1.36-.35-2.12s.13-1.46.35-2.12V7.04H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.96l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.04l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
            </svg>
            Continue with Google
          </a>
        </div>

        <div class="v2-divider">or sign in with email</div>

        <form id="login-form" action="<%= loginAction %>" method="POST" novalidate>
          <input type="hidden" name="next" value="<%= next %>">
          <div class="v2-field">
            <input class="v2-input" id="login-email" name="email" type="email" autocomplete="email" required placeholder=" " value="<%= locals.email || '' %>">
            <label for="login-email">Email</label>
          </div>
          <div class="v2-field">
            <input class="v2-input has-eye" id="login-password" name="password" type="password" autocomplete="current-password" required placeholder=" ">
            <label for="login-password">Password</label>
            <button type="button" class="v2-eye" data-eye-for="login-password" aria-label="Show password" aria-pressed="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <p class="v2-forgot"><a href="/forgot-password">Forgot your password?</a></p>
          <p class="v2-alert" id="login-error" role="alert" hidden></p>
          <div class="v2-actions v2-actions-1"><button type="submit" class="v2-btn v2-btn-ink">Sign in</button></div>
        </form>

        <!-- Passwordless: emails a 6-digit sign-in code (POST /login/email-code). -->
        <form id="code-form" action="/login/email-code" method="POST" hidden>
          <input type="hidden" name="email" id="code-email">
          <input type="hidden" name="next" value="<%= next %>">
        </form>
        <p class="v2-switch">Prefer no password? <button type="button" class="v2-linkbtn" id="use-code">Email me a sign-in code</button></p>
        <p class="v2-switch">Don't have an account yet? <a href="/signup">Sign up</a></p>

        <p class="v2-disclaimer-line">Maal does not provide financial advice. Any information provided by Maal is for educational purposes only. You should do your own research. Investing is risky and you can lose all of your money.</p>
      </div>
    </section>

<%- include('partials/v2-sky') %>
  </main>

  <script src="/js/v2-auth.js"></script>
  <script>
  (function () {
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var email = document.getElementById('login-email');
    var pw = document.getElementById('login-password');
    var err = document.getElementById('login-error');
    function fail(msg, el) { err.textContent = msg; err.hidden = false; el.focus(); }

    // Client-side check only for obvious slips; the server re-validates.
    document.getElementById('login-form').addEventListener('submit', function (e) {
      if (!EMAIL_RE.test(email.value.trim())) { e.preventDefault(); return fail('Please enter a valid email address.', email); }
      if (!pw.value) { e.preventDefault(); return fail('Please enter your password.', pw); }
    });
    document.getElementById('use-code').addEventListener('click', function () {
      var v = email.value.trim();
      if (!EMAIL_RE.test(v)) return fail('Enter your email above and we’ll send you a sign-in code.', email);
      document.getElementById('code-email').value = v;
      document.getElementById('code-form').submit();
    });
    if (!email.value) email.focus(); else pw.focus();
  })();
  </script>
</body>
</html>
