<%
  // Forgot password — v2 (Figma "Resetting password from Logging in":
  // Reset your password → Check your email). Locals: error, sent, email.
  // `sent` is true for EVERY well-formed address, registered or not, so this
  // page never reveals whether an account exists.
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/v2-head', { title: locals.sent ? 'Check your email' : 'Reset your password' }) %>
</head>
<body class="v2 v2-focus-page">
<%- include('partials/v2-focus-header', { back: '/login' }) %>
  <main class="v2-focus">
    <div class="v2-focus-inner">
      <% if (locals.sent) { %>
        <%- include('partials/v2-icon', { name: 'check' }) %>
        <h1>Check your email</h1>
        <p class="v2-focus-sub">If there’s a Maal account for this address, we’ve emailed you a link to reset your password. The link works once and expires in 1 hour.</p>
        <p class="v2-focus-sub">Can't see it? Check your junk, spam, promotions or other folders.</p>
        <div class="v2-focus-actions"><a href="/login" class="v2-btn v2-btn-ink">Back to sign in</a></div>
        <p class="v2-switch">Wrong address? <a href="/forgot-password">Try another email</a></p>
      <% } else { %>
        <%- include('partials/v2-icon', { name: 'mail' }) %>
        <h1>Reset your password</h1>
        <p class="v2-focus-sub">Enter the email you use for Maal and we'll send you a link to reset your password.</p>
        <% if (locals.error) { %><div class="v2-alert" role="alert"><%= error %></div><% } %>
        <form id="forgot-form" action="/forgot-password" method="POST" class="v2-focus-form" novalidate>
          <div class="v2-field">
            <input class="v2-input" id="forgot-email" name="email" type="email" autocomplete="email" required placeholder=" " value="<%= locals.email || '' %>">
            <label for="forgot-email">Email, e.g. name@email.com</label>
          </div>
          <div class="v2-focus-actions"><button type="submit" class="v2-btn v2-btn-ink" id="forgot-next">Next <span aria-hidden="true">&rarr;</span></button></div>
        </form>
      <% } %>
    </div>
  </main>
<%- include('partials/v2-focus-footer') %>
  <% if (!locals.sent) { %>
  <script nonce="<%= locals.cspNonce || '' %>">
  (function () {
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var email = document.getElementById('forgot-email');
    var next = document.getElementById('forgot-next');
    // Figma: Next stays disabled until the address looks like an email.
    function update() { next.disabled = !EMAIL_RE.test(email.value.trim()); }
    email.addEventListener('input', update);
    update();
    email.focus();
  })();
  </script>
  <% } %>
</body>
</html>
