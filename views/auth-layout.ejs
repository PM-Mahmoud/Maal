<%
  // v2 single-task auth layout (express-ejs-layouts). Not used by any route
  // today — the auth pages are full documents built from the same partials —
  // but kept so a new auth step can render with { layout: 'auth-layout',
  // title, back }. Same look as auth-forgot-password.ejs / auth-reset-password.ejs.
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/v2-head', { title: typeof title !== 'undefined' ? title : 'Maal' }) %>
</head>
<body class="v2 v2-focus-page">
<%- include('partials/v2-focus-header', { back: typeof back !== 'undefined' ? back : '/login' }) %>
  <main class="v2-focus">
    <div class="v2-focus-inner">
      <%- body %>
    </div>
  </main>
<%- include('partials/v2-focus-footer') %>
</body>
</html>
