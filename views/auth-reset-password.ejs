<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <title>Set new password — Mizan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
    .auth-wrap { width: 100%; max-width: 420px; }
    .auth-logo { text-align: center; margin-bottom: 2.5rem; }
    .auth-card { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 2.5rem; }
    .auth-card h1 { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; color: var(--fg); margin: 0 0 0.35rem; }
    .auth-card .subtitle { font-size: 0.875rem; color: var(--fg-muted); margin: 0 0 2rem; line-height: 1.55; }
    .form-group { margin-bottom: 1.1rem; }
    .form-group label { display: block; font-size: 0.75rem; font-weight: 500; color: var(--fg-muted); margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.07em; }
    .form-group input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.7rem 0.9rem; color: var(--fg); font-size: 0.9rem; font-family: var(--font-body); outline: none; transition: border-color 0.2s; box-sizing: border-box; }
    .form-group input:focus { border-color: var(--accent); }
    .form-group input::placeholder { color: var(--fg-muted); opacity: 0.5; }
    .btn-primary { width: 100%; background: var(--accent); color: #fff; font-weight: 600; font-size: 0.9rem; padding: 0.8rem 1.5rem; border: none; border-radius: 8px; cursor: pointer; font-family: var(--font-body); transition: opacity 0.2s; }
    .btn-primary:hover { opacity: 0.85; }
    .alert { padding: 0.75rem 0.9rem; border-radius: 8px; font-size: 0.825rem; margin-bottom: 1.1rem; line-height: 1.5; }
    .alert-error { background: var(--danger-soft); border: 1px solid rgba(224,112,112,0.3); color: var(--danger); }
    .alert-success { background: rgba(126,212,166,0.12); border: 1px solid rgba(126,212,166,0.3); color: var(--accent-strong); }
    @media (max-width: 480px) { .auth-card { padding: 1.75rem 1.25rem; } }
  </style>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-logo">
      <a href="/">
        <span style="font-size:1.8rem;color:var(--accent);">◈</span>
        <span style="font-family:var(--font-display);font-size:1.3rem;font-weight:600;color:var(--fg);">Mizan</span>
      </a>
    </div>
    <div class="auth-card">
      <h1>Set a new password</h1>
      <p class="subtitle">Choose a strong password for your account.</p>

      <% if (error && !success) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success">Password updated! You can now sign in.</div>
        <a href="/login" class="btn-primary" style="display:block;text-align:center;text-decoration:none;">Sign in</a>
      <% } else if (token) { %>
        <form action="/reset-password" method="POST">
          <input type="hidden" name="token" value="<%= token %>">
          <div class="form-group">
            <label for="password">New password</label>
            <input type="password" id="password" name="password" placeholder="At least 8 characters" required minlength="8">
          </div>
          <button type="submit" class="btn-primary">Update password</button>
        </form>
      <% } else { %>
        <div class="alert alert-error">This reset link is invalid or has expired.</div>
        <a href="/forgot-password" class="btn-primary" style="display:block;text-align:center;text-decoration:none;">Request new link</a>
      <% } %>
    </div>
  </div>
</body>
</html>