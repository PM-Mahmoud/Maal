<%
  // Reset password — v2 (Figma "Resetting password from Logging in":
  // Create your password → Confirm your new password → Password reset
  // successful). Both password steps post ONE form; JS switches between them.
  // Locals: token ('' = invalid/expired link), error, success.
  const state = locals.success ? 'done' : (locals.token ? 'form' : 'invalid');
  const titles = { done: 'Password reset successful', form: 'Create your password', invalid: 'Reset link expired' };
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/v2-head', { title: titles[state] }) %>
</head>
<body class="v2 v2-focus-page">
<%- include('partials/v2-focus-header', { back: state === 'form' ? '#step-create' : (state === 'invalid' ? '/login' : null) }) %>
  <main class="v2-focus">
    <div class="v2-focus-inner">
    <% if (state === 'done') { %>
      <%- include('partials/v2-icon', { name: 'check' }) %>
      <h1>Password reset successful</h1>
      <p class="v2-focus-sub">You can now sign in with your new password. For your security, we've signed you out on your other devices.</p>
      <p class="v2-focus-link"><a href="/login?reset=1">Sign in with new password</a></p>
    <% } else if (state === 'invalid') { %>
      <%- include('partials/v2-icon', { name: 'cross' }) %>
      <h1>This link has expired</h1>
      <p class="v2-focus-sub"><%= locals.error || 'This reset link is invalid or has expired.' %> Reset links work once and last for 1 hour.</p>
      <div class="v2-focus-actions"><a href="/forgot-password" class="v2-btn v2-btn-ink">Send me a new link</a></div>
      <p class="v2-switch">Remembered it? <a href="/login">Back to sign in</a></p>
    <% } else { %>
      <form id="reset-form" action="/reset-password" method="POST" class="v2-focus-form" novalidate>
        <input type="hidden" name="token" value="<%= token %>">

        <!-- Step 1: Create your password -->
        <div id="step-create">
          <%- include('partials/v2-icon', { name: 'password' }) %>
          <h1>Create your password</h1>
          <% if (locals.error) { %><div class="v2-alert" role="alert"><%= error %></div><% } %>
          <div class="v2-field">
            <input class="v2-input has-eye" id="reset-password" name="password" type="password" autocomplete="new-password" required maxlength="64" placeholder=" " aria-describedby="pw-rules">
            <label for="reset-password">Password</label>
            <button type="button" class="v2-eye" data-eye-for="reset-password" aria-label="Show password" aria-pressed="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="v2-strength" aria-live="polite"><span id="pw-label"></span><span class="v2-strength-bars" id="pw-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span></div>
          <!-- Exactly the rules the server enforces (lib/password-rules.js; test/password-rules.test.js checks this list). -->
          <ul class="v2-rules" id="pw-rules">
            <li data-rule="upper">1 uppercase letter</li>
            <li data-rule="lower">1 lowercase letter</li>
            <li data-rule="num">1 number</li>
            <li data-rule="len">8 to 64 characters</li>
            <li data-rule="special">1 special character</li>
          </ul>
          <div class="v2-focus-actions"><button type="button" class="v2-btn v2-btn-ink" id="to-confirm" disabled>Create password</button></div>
        </div>

        <!-- Step 2: Confirm your new password -->
        <div id="step-confirm" hidden>
          <%- include('partials/v2-icon', { name: 'password' }) %>
          <h1>Confirm your new password</h1>
          <p class="v2-alert" id="confirm-error" role="alert" hidden></p>
          <div class="v2-field">
            <input class="v2-input has-eye" id="reset-confirm" name="confirm" type="password" autocomplete="new-password" maxlength="64" placeholder=" ">
            <label for="reset-confirm">Re-enter your password</label>
            <button type="button" class="v2-eye" data-eye-for="reset-confirm" aria-label="Show password" aria-pressed="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="v2-focus-actions"><button type="submit" class="v2-btn v2-btn-ink" id="confirm-btn" disabled>Confirm</button></div>
        </div>
      </form>
    <% } %>
    </div>
  </main>
<%- include('partials/v2-focus-footer') %>
  <% if (state === 'form') { %>
  <script src="/js/v2-auth.js"></script>
  <script>
  (function () {
    var pw = document.getElementById('reset-password');
    var confirm = document.getElementById('reset-confirm');
    var stepCreate = document.getElementById('step-create');
    var stepConfirm = document.getElementById('step-confirm');
    var toConfirm = document.getElementById('to-confirm');
    var confirmBtn = document.getElementById('confirm-btn');
    var confirmErr = document.getElementById('confirm-error');
    var back = document.querySelector('[data-back]');

    var rules = window.MaalAuth.passwordRules(pw, {
      rulesEl: document.getElementById('pw-rules'),
      labelEl: document.getElementById('pw-label'),
      barsEl: document.getElementById('pw-bars'),
      onChange: function (ok) { toConfirm.disabled = !ok; }
    });

    function show(step) {
      var confirming = step === 'confirm';
      stepCreate.hidden = confirming;
      stepConfirm.hidden = !confirming;
      if (back) back.hidden = !confirming; // Figma: Back only on the confirm step
      (confirming ? confirm : pw).focus();
    }
    toConfirm.addEventListener('click', function () { if (rules.isValid()) show('confirm'); });
    pw.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); if (rules.isValid()) show('confirm'); }
    });
    if (back) back.addEventListener('click', function () { confirmErr.hidden = true; show('create'); });
    confirm.addEventListener('input', function () { confirmBtn.disabled = !confirm.value; confirmErr.hidden = true; });

    document.getElementById('reset-form').addEventListener('submit', function (e) {
      if (!rules.isValid()) { e.preventDefault(); show('create'); return; }
      if (confirm.value !== pw.value) {
        e.preventDefault();
        confirmErr.textContent = "Those passwords don't match. Check and try again.";
        confirmErr.hidden = false;
        confirm.focus();
        return;
      }
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Saving…';
    });
    pw.focus();
  })();
  </script>
  <% } %>
</body>
</html>
