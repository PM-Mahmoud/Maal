<!DOCTYPE html>
<html lang="en-AU">
<head>
  <%- include('partials/v2-head', { title: 'Link your Google account' }) %>
</head>
<body class="v2 v2-focus-page">
  <%- include('partials/v2-focus-header', { backHref: '/login' }) %>
  <main class="v2-focus">
    <div class="v2-focus-inner">
      <h1 class="v2-focus-title">Link your Google account</h1>
      <p class="v2-focus-sub">Sign in with the password for <strong class="v2-wrap-address"><%= email %></strong> to link this sign-in method.</p>
      <div class="v2-focus-actions"><a href="/login" class="v2-btn v2-btn-ink">Sign in with password</a></div>
      <p class="v2-switch"><a href="/">Cancel</a></p>
    </div>
  </main>
  <%- include('partials/v2-focus-footer') %>
</body>
</html>
