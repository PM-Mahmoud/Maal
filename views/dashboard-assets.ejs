<%
  function aud(n) { n = Number(n) || 0; return '$' + n.toLocaleString('en-AU', { maximumFractionDigits: 0 }); }
  // Number() — Postgres returns BIGINT as strings; avoid string concatenation
  var liveAcc      = (typeof liveAccounts !== 'undefined' && liveAccounts) ? liveAccounts : [];
  var cashRows      = (typeof cashAccounts !== 'undefined' && cashAccounts) ? cashAccounts : [];
  var investRows    = (typeof investments !== 'undefined' && investments) ? investments : [];
  var propertyRows  = (typeof properties !== 'undefined' && properties) ? properties : [];
  var debtRows      = (typeof debts !== 'undefined' && debts) ? debts : [];
  var superRows     = (typeof superAccounts !== 'undefined' && superAccounts) ? superAccounts : [];
  var otherRows     = (typeof otherAssets !== 'undefined' && otherAssets) ? otherAssets : [];

  var PROPERTY_TYPE_LABELS = { residential: 'Residential', commercial: 'Commercial' };
  var DEBT_KIND_LABELS = { credit_card: 'Credit card', mortgage: 'Mortgage', loan: 'Loan', other: 'Other debt' };
  var INVEST_KIND_LABELS = { shares: 'Shares', etf: 'ETF', crypto: 'Crypto', other: 'Other' };
  var OTHER_KIND_LABELS = { vehicle: 'Vehicle', precious_metals: 'Precious metals', private_investment: 'Private investment', collectible: 'Collectible', other: 'Other' };
%>

<div class="page-head">
  <div>
    <h1>My Portfolio</h1>
    <div class="sub">Everything you own and owe, in one place.</div>
  </div>
</div>

<div class="widget-grid">
  <div class="col-8">

    <% if (liveAcc.length) { %>
    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Connected accounts <span class="chip chip-accent">● Live via Basiq</span>
        <a class="more" href="/basiq/sync">↻ Sync</a>
      </div>
      <% liveAcc.forEach(function(a) { %>
      <div class="row-item">
        <div><div class="row-main"><%= a.institution_name || 'Bank account' %></div><div class="row-sub"><%= (a.institution_type || 'account') %> · live balance</div></div>
        <div class="row-val"><%= aud(a.balance) %></div>
      </div>
      <% }); %>
      <p style="font-size:0.72rem; color:var(--fg-faint); margin:0.7rem 0 0; line-height:1.6;">
        Live balances sync automatically — you don't need to add these manually below.
      </p>
    </div>
    <% } %>

    <!-- ── Superannuation ── -->
    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Superannuation <span class="chip chip-muted">Manual</span></div>
      <% superRows.filter(function(r) { return r.source !== 'basiq'; }).forEach(function(r) { %>
        <div class="row-item">
          <div><div class="row-main"><%= r.label || 'Super fund' %></div><div class="row-sub"><%= r.fund_name || 'Superannuation' %></div></div>
          <div class="row-val"><%= aud(r.balance) %></div>
          <div class="row-actions">
            <button class="btn-icon" data-row-edit data-row-type="super" data-row-id="<%= r.id %>" data-row-json='<%- JSON.stringify(r) %>' aria-label="Edit super fund">✎</button>
            <button class="btn-icon btn-icon-danger" data-row-delete data-row-type="super" data-row-id="<%= r.id %>" data-row-label="<%= r.label || 'Super fund' %>" aria-label="Remove super fund">✕</button>
          </div>
        </div>
      <% }); %>
      <% if (!superRows.filter(function(r) { return r.source !== 'basiq'; }).length) { %>
        <div class="empty">
          <h3>No super fund added</h3>
          <p>Add your super — AustralianSuper, HESTA, Hostplus, Aware, UniSuper or any fund — to track Australia's biggest retirement asset.</p>
        </div>
      <% } %>
      <button class="btn btn-accent btn-sm" data-row-add data-row-type="super">+ Add Super Fund</button>
    </div>

    <!-- ── Assets: investments + property ── -->
    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Assets</div>
      <% investRows.filter(function(r) { return r.source !== 'basiq'; }).forEach(function(r) { %>
        <div class="row-item">
          <div><div class="row-main"><%= r.name || 'Investment' %></div><div class="row-sub"><%= INVEST_KIND_LABELS[r.kind] || r.kind || 'Other' %></div></div>
          <div class="row-val"><%= aud(r.value) %></div>
          <div class="row-actions">
            <button class="btn-icon" data-row-edit data-row-type="investments" data-row-id="<%= r.id %>" data-row-json='<%- JSON.stringify(r) %>' aria-label="Edit investment">✎</button>
            <button class="btn-icon btn-icon-danger" data-row-delete data-row-type="investments" data-row-id="<%= r.id %>" data-row-label="<%= r.name || 'Investment' %>" aria-label="Remove investment">✕</button>
          </div>
        </div>
      <% }); %>
      <% propertyRows.forEach(function(r) { %>
        <div class="row-item">
          <div><div class="row-main"><%= r.label || 'Property' %></div><div class="row-sub"><%= PROPERTY_TYPE_LABELS[r.property_type] || 'Residential' %><%= Number(r.mortgage_balance) > 0 ? ' · ' + aud(r.mortgage_balance) + ' mortgage' : '' %></div></div>
          <div class="row-val"><%= aud(r.value) %></div>
          <div class="row-actions">
            <button class="btn-icon" data-row-edit data-row-type="properties" data-row-id="<%= r.id %>" data-row-json='<%- JSON.stringify(r) %>' aria-label="Edit property">✎</button>
            <button class="btn-icon btn-icon-danger" data-row-delete data-row-type="properties" data-row-id="<%= r.id %>" data-row-label="<%= r.label || 'Property' %>" aria-label="Remove property">✕</button>
          </div>
        </div>
      <% }); %>
      <% if (!investRows.filter(function(r) { return r.source !== 'basiq'; }).length && !propertyRows.length) { %>
        <div class="empty">
          <h3>No assets yet</h3>
          <p>Add cash, shares, ETFs, property, crypto or anything else you own.</p>
        </div>
      <% } %>
      <div style="display:flex; gap:0.5rem; margin-top:0.5rem;">
        <button class="btn btn-accent btn-sm" data-row-add data-row-type="investments">+ Add Investment</button>
        <button class="btn btn-ghost btn-sm" data-row-add data-row-type="properties">+ Add Property</button>
      </div>
    </div>

    <!-- ── Other assets: vehicles, precious metals, private investments, collectibles ── -->
    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Other Assets</div>
      <% otherRows.forEach(function(r) { %>
        <div class="row-item">
          <div><div class="row-main"><%= r.label || 'Other asset' %></div><div class="row-sub"><%= OTHER_KIND_LABELS[r.kind] || 'Other' %></div></div>
          <div class="row-val"><%= aud(r.value) %></div>
          <div class="row-actions">
            <button class="btn-icon" data-row-edit data-row-type="other" data-row-id="<%= r.id %>" data-row-json='<%- JSON.stringify(r) %>' aria-label="Edit asset">✎</button>
            <button class="btn-icon btn-icon-danger" data-row-delete data-row-type="other" data-row-id="<%= r.id %>" data-row-label="<%= r.label || 'Other asset' %>" aria-label="Remove asset">✕</button>
          </div>
        </div>
      <% }); %>
      <% if (!otherRows.length) { %>
        <div class="empty">
          <h3>No other assets yet</h3>
          <p>Track vehicles, precious metals, private investments or collectibles.</p>
        </div>
      <% } %>
      <button class="btn btn-accent btn-sm" data-row-add data-row-type="other">+ Add Other Asset</button>
    </div>

    <!-- ── Cash ── -->
    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Cash &amp; Savings</div>
      <% cashRows.filter(function(r) { return r.source !== 'basiq'; }).forEach(function(r) { %>
        <div class="row-item">
          <div><div class="row-main"><%= r.label || 'Bank account' %></div><div class="row-sub"><%= r.institution || 'Manual entry' %></div></div>
          <div class="row-val"><%= aud(r.balance) %></div>
          <div class="row-actions">
            <button class="btn-icon" data-row-edit data-row-type="cash" data-row-id="<%= r.id %>" data-row-json='<%- JSON.stringify(r) %>' aria-label="Edit account">✎</button>
            <button class="btn-icon btn-icon-danger" data-row-delete data-row-type="cash" data-row-id="<%= r.id %>" data-row-label="<%= r.label || 'Bank account' %>" aria-label="Remove account">✕</button>
          </div>
        </div>
      <% }); %>
      <% if (!cashRows.filter(function(r) { return r.source !== 'basiq'; }).length) { %>
        <div class="empty">
          <h3>No cash accounts added</h3>
          <p>Add a bank account, savings account or term deposit.</p>
        </div>
      <% } %>
      <button class="btn btn-accent btn-sm" data-row-add data-row-type="cash">+ Add Cash Account</button>
    </div>

    <!-- ── Liabilities ── -->
    <div class="panel">
      <div class="panel-title">Liabilities</div>
      <% debtRows.filter(function(r) { return r.source !== 'basiq'; }).forEach(function(r) { %>
        <div class="row-item">
          <div><div class="row-main"><%= r.label || 'Debt' %></div><div class="row-sub"><%= DEBT_KIND_LABELS[r.kind] || 'Other debt' %><%= Number(r.interest_rate) > 0 ? ' · ' + r.interest_rate + '% p.a.' : '' %></div></div>
          <div class="row-val"><%= aud(r.balance) %></div>
          <div class="row-actions">
            <button class="btn-icon" data-row-edit data-row-type="debts" data-row-id="<%= r.id %>" data-row-json='<%- JSON.stringify(r) %>' aria-label="Edit debt">✎</button>
            <button class="btn-icon btn-icon-danger" data-row-delete data-row-type="debts" data-row-id="<%= r.id %>" data-row-label="<%= r.label || 'Debt' %>" aria-label="Remove debt">✕</button>
          </div>
        </div>
      <% }); %>
      <p style="font-size:0.72rem; color:var(--fg-faint); margin:0.5rem 0;">
        HECS-HELP is tracked separately on your <a href="/dashboard/profile" style="color:var(--accent);">Profile</a> page (it's income-contingent, not a commercial debt).
      </p>
      <% if (!debtRows.filter(function(r) { return r.source !== 'basiq'; }).length) { %>
        <div class="empty">
          <h3>No other liabilities</h3>
          <p>Track mortgages, car loans and credit cards.</p>
        </div>
      <% } %>
      <button class="btn btn-danger-soft btn-sm" data-row-add data-row-type="debts">+ Add Liability</button>
    </div>

  </div>

  <div class="col-4">
    <div class="panel">
      <div class="panel-title">Connect Accounts <span class="chip chip-accent">via Basiq</span></div>
      <div class="field"><input type="search" data-inst-search placeholder="Search institutions…"></div>
      <div class="inst-grid" <%= (typeof basiqEnabled !== 'undefined' && basiqEnabled) ? 'data-basiq-live' : '' %>>
        <div class="inst"><span class="inst-logo" style="background:#FFCC00; color:#000;">CBA</span><span class="inst-name">CommBank</span></div>
        <div class="inst"><span class="inst-logo" style="background:#DA1710;">W</span><span class="inst-name">Westpac</span></div>
        <div class="inst"><span class="inst-logo" style="background:#C20000;">NAB</span><span class="inst-name">NAB</span></div>
        <div class="inst"><span class="inst-logo" style="background:#007DBA;">ANZ</span><span class="inst-name">ANZ</span></div>
        <div class="inst"><span class="inst-logo" style="background:#1D252C;">MQ</span><span class="inst-name">Macquarie</span></div>
        <div class="inst"><span class="inst-logo" style="background:#FF6200;">ING</span><span class="inst-name">ING</span></div>
        <div class="inst"><span class="inst-logo" style="background:#FF7A64;">Up</span><span class="inst-name">Up</span></div>
        <div class="inst"><span class="inst-logo" style="background:#0EBB5F;">UB</span><span class="inst-name">UBank</span></div>
        <div class="inst"><span class="inst-logo" style="background:#A8003D;">BEN</span><span class="inst-name">Bendigo</span></div>
      </div>
      <p style="font-size:0.72rem; color:var(--fg-faint); margin:0.9rem 0 0; line-height:1.6;">
        🔒 Your data is secure. Connections are made through Basiq under Australia's Consumer Data Right (open banking).
        Maal is read-only — it cannot move money or make changes to your accounts. Revoke access anytime.
        We never store banking credentials and your data is never sold.
      </p>
    </div>
  </div>
</div>
