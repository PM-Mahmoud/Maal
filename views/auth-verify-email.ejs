<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <title>Verify email — Maal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
    .auth-wrap { width: 100%; max-width: 420px; text-align: center; }
    .auth-logo { margin-bottom: 2rem; }
    .auth-card { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 2.5rem; }
    .auth-card h1 { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; color: var(--fg); margin: 0 0 0.75rem; }
    .auth-card p { font-size: 0.9rem; color: var(--fg-muted); line-height: 1.6; margin: 0 0 1.5rem; }
    .icon { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .btn-primary { display: inline-block; background: var(--accent); color: #fff; font-weight: 600; font-size: 0.9rem; padding: 0.8rem 2rem; border: none; border-radius: 8px; cursor: pointer; font-family: var(--font-body); text-decoration: none; transition: opacity 0.2s; }
    .btn-primary:hover { opacity: 0.85; }
    @media (max-width: 480px) { .auth-card { padding: 1.75rem 1.25rem; } }
  </style>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-logo">
      <a href="/">
        <span style="font-size:1.8rem;color:var(--accent);">◈</span>
        <span style="font-family:var(--font-display);font-size:1.3rem;font-weight:600;color:var(--fg);">Maal</span>
      </a>
    </div>
    <div class="auth-card">
      <% if (success) { %>
        <span class="icon">✓</span>
        <h1>Email verified!</h1>
        <p>Your email is confirmed. Head to your dashboard to see your financial health score.</p>
        <a href="/dashboard" class="btn-primary">Go to dashboard</a>
      <% } else { %>
        <span class="icon" style="color:#E07070;">✕</span>
        <h1>Verification failed</h1>
        <p><%= error || 'This link is invalid or has expired.' %></p>
        <a href="/signup" class="btn-primary">Create new account</a>
      <% } %>
    </div>
  </div>
</body>
</html>