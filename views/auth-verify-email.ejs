<%
  // Email-link verification result — v2. (Legacy: today's sign-up confirms
  // with a 6-digit code on auth-verify-otp.ejs.) Locals: success, error.
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/v2-head', { title: locals.success ? 'Email confirmed' : 'Verification failed' }) %>
</head>
<body class="v2 v2-focus-page">
<%- include('partials/v2-focus-header', { back: null }) %>
  <main class="v2-focus">
    <div class="v2-focus-inner">
      <% if (locals.success) { %>
        <%- include('partials/v2-icon', { name: 'check' }) %>
        <h1>Email confirmed</h1>
        <p class="v2-focus-sub">Thanks — your email is confirmed. Head to your dashboard to see where you stand.</p>
        <div class="v2-focus-actions"><a href="/app" class="v2-btn v2-btn-ink">Go to dashboard</a></div>
      <% } else { %>
        <%- include('partials/v2-icon', { name: 'cross' }) %>
        <h1>Verification failed</h1>
        <p class="v2-focus-sub"><%= locals.error || 'This link is invalid or has expired.' %></p>
        <div class="v2-focus-actions"><a href="/login" class="v2-btn v2-btn-ink">Back to sign in</a></div>
        <p class="v2-switch">New to Maal? <a href="/signup">Create an account</a></p>
      <% } %>
    </div>
  </main>
<%- include('partials/v2-focus-footer') %>
</body>
</html>
