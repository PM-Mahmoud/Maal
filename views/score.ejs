<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <title>Free Maal Score Calculator — 2 minutes</title>
  <meta name="description" content="Get your 0–100 Maal Financial Health Score in 2 minutes. No bank login, no credit card.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/retro-theme.css">
  <style>
    body { background: var(--bg); min-height: 100vh; display: flex; flex-direction: column; }
    main { flex: 1; }
    .sc-wrap { max-width: 700px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
    .sc-kicker { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .18em; color: var(--fg-muted); margin-bottom: .75rem; }
    .sc-h1 { font-size: clamp(2rem,5vw,2.5rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.1; }
    .sc-progress { height: 4px; background: var(--surface-2); border-radius: 99px; overflow: hidden; margin-top: 1.5rem; }
    .sc-progress-fill { height: 100%; background: var(--mint); border-radius: 99px; transition: width .5s ease; }
    .sc-fields { margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
    .sc-label { display: block; }
    .sc-label-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: .5rem; }
    .sc-label-text { font-size: 12px; font-weight: 600; }
    .sc-label-hint-inline { font-size: 11px; color: var(--fg-muted); }
    .sc-input { width: 100%; height: 52px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); font-size: 20px; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; font-family: var(--font-body); color: var(--fg); outline: none; box-sizing: border-box; transition: border-color .15s; }
    .sc-input:focus { border-color: var(--fg); }
    .sc-hint { margin-top: .375rem; font-size: 11px; color: var(--fg-muted); }
    .sc-nav { margin-top: 2.5rem; display: flex; align-items: center; justify-content: space-between; }
    .sc-back { font-size: 13px; font-weight: 600; color: var(--fg-muted); background: none; border: none; cursor: pointer; font-family: var(--font-body); }
    .sc-back:hover { color: var(--fg); }
    .sc-back:disabled { opacity: .3; cursor: default; }
    .sc-next { height: 44px; padding: 0 1.25rem; border-radius: 8px; background: var(--fg); color: #fff; font-size: 13px; font-weight: 600; border: none; cursor: pointer; font-family: var(--font-body); transition: opacity .15s; }
    .sc-next:hover { opacity: .88; }
    .sc-disclaimer { margin-top: 3rem; font-size: 11px; color: var(--fg-muted); line-height: 1.75; }
    /* Result */
    .sc-result-box { margin-top: 2.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.75rem; }
    .sc-result-top { display: grid; grid-template-columns: auto 1fr; gap: 1.75rem; align-items: center; }
    @media (max-width: 480px) { .sc-result-top { grid-template-columns: 1fr; justify-items: center; } }
    .sc-ring-wrap { position: relative; width: 168px; height: 168px; flex-shrink: 0; }
    .sc-ring-label { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .sc-ring-num { font-size: 2.5rem; font-weight: 700; letter-spacing: -.03em; font-variant-numeric: tabular-nums; line-height: 1; }
    .sc-ring-denom { font-size: 12px; color: var(--fg-muted); margin-top: .2rem; }
    .sc-band-pill { display: inline-flex; align-items: center; gap: .375rem; padding: .2rem .625rem; border-radius: 99px; background: rgba(18,181,166,.1); border: 1px solid rgba(18,181,166,.2); }
    .sc-band-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--mint); }
    .sc-band-text { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; color: var(--mint); }
    .sc-result-desc { margin-top: .75rem; font-size: 15px; color: var(--fg-muted); line-height: 1.65; }
    .sc-signal-block { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
    .sc-signal-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .625rem; }
    .sc-signal-title--up { color: var(--accent-strong); }
    .sc-signal-title--down { color: var(--gold); }
    .sc-signal-row { display: flex; align-items: baseline; gap: .5rem; font-size: 13px; color: var(--fg); line-height: 1.6; margin-bottom: .375rem; }
    .sc-signal-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; margin-top: .5rem; }
    .sc-signal-dot--up { background: var(--mint); }
    .sc-signal-dot--down { background: var(--gold); }
    .sc-next-title { font-size: 13px; font-weight: 700; }
    .sc-next-list { margin: .875rem 0 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: .625rem; }
    .sc-next-list li { font-size: 13.5px; color: var(--fg); line-height: 1.6; }
    .sc-pillars { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: .875rem; }
    .sc-pillar-row { display: flex; align-items: center; justify-content: space-between; font-size: 12px; margin-bottom: .375rem; }
    .sc-pillar-name { }
    .sc-pillar-weight { color: var(--fg-muted); margin-left: .25rem; }
    .sc-pillar-score { font-weight: 600; font-variant-numeric: tabular-nums; }
    .sc-pillar-bar-bg { height: 6px; background: var(--surface-2); border-radius: 99px; overflow: hidden; }
    .sc-pillar-bar-fill { height: 100%; border-radius: 99px; transition: width 1.2s cubic-bezier(.2,.8,.2,1); }
    .sc-email-box { margin-top: 2rem; padding: 1.5rem; border-radius: 14px; border: 1px solid var(--border); background: rgba(0,0,0,.02); }
    html[data-theme="dark"] .sc-email-box { background: rgba(255,255,255,.03); }
    .sc-email-title { font-size: 13px; font-weight: 600; }
    .sc-email-body { font-size: 12px; color: var(--fg-muted); margin-top: .25rem; margin-bottom: 1rem; }
    .sc-email-row { display: flex; flex-direction: column; gap: .5rem; }
    @media (min-width: 480px) { .sc-email-row { flex-direction: row; } }
    .sc-email-input { flex: 1; height: 44px; padding: 0 .875rem; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); font-size: 14px; font-family: var(--font-body); color: var(--fg); outline: none; box-sizing: border-box; transition: border-color .15s; }
    .sc-email-input:focus { border-color: var(--fg); }
    .sc-email-input::placeholder { color: var(--fg-muted); }
    .sc-email-btn { height: 44px; padding: 0 1.25rem; border-radius: 8px; background: var(--fg); color: #fff; font-size: 13px; font-weight: 600; border: none; cursor: pointer; font-family: var(--font-body); white-space: nowrap; transition: opacity .15s; }
    .sc-email-btn:hover { opacity: .88; }
    .sc-email-sent { padding: 1.5rem; border-radius: 14px; border: 1px solid rgba(18,181,166,.3); background: rgba(18,181,166,.05); }
    .sc-email-sent-title { font-size: 13px; font-weight: 600; }
    .sc-email-sent-body { font-size: 12px; color: var(--fg-muted); margin-top: .25rem; }
    .sc-result-nav { margin-top: 2rem; display: flex; align-items: center; justify-content: space-between; }
    .sc-restart { font-size: 13px; font-weight: 600; color: var(--fg-muted); background: none; border: none; cursor: pointer; font-family: var(--font-body); }
    .sc-restart:hover { color: var(--fg); }
    /* Intro */
    .sc-intro-body { margin-top: 1rem; font-size: 15px; color: var(--fg-muted); line-height: 1.65; }
    .sc-intro-trust { margin-top: 1.25rem; font-size: 12px; color: var(--fg-muted); }
    .sc-intro-start { margin-top: 2rem; height: 48px; padding: 0 1.5rem; border-radius: 8px; background: var(--fg); color: #fff; font-size: 14px; font-weight: 600; border: none; cursor: pointer; font-family: var(--font-body); transition: opacity .15s; }
    .sc-intro-start:hover { opacity: .88; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section>
      <div class="sc-wrap" id="sc-app">
        <!-- JS renders the wizard here -->
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- analyticsSnippet %>

  <script>
  (function() {
    'use strict';

    var root = document.getElementById('sc-app');
    var step = 0;
    var introShown = false;
    var inputs = { age: 35, income: 95000, assets: 250000, debts: 80000, superBalance: 90000 };
    var STEPS = [
      { title: 'You', question: 'How old are you and what do you earn?',
        fields: [
          { key: 'age', label: 'Age', suffix: 'years', min: 16, max: 100, step: 1, prefix: false },
          { key: 'income', label: 'Annual income (before tax)', prefix: '$', step: 1000, min: 0 }
        ]
      },
      { title: 'Wealth', question: 'Roughly what do you own?',
        fields: [
          { key: 'assets', label: 'Total assets', prefix: '$', step: 1000, min: 0, hint: 'Home, investments, savings — everything you own.' }
        ]
      },
      { title: 'Debt', question: 'And what do you owe?',
        fields: [
          { key: 'debts', label: 'Total debts', prefix: '$', step: 1000, min: 0, hint: 'Mortgage, HECS, car, credit cards.' }
        ]
      },
      { title: 'Super', question: "What's your current super balance?",
        fields: [
          { key: 'superBalance', label: 'Super balance', prefix: '$', step: 1000, min: 0, hint: 'Combined across all your funds.' }
        ]
      },
    ];

    function computeScore(inp) {
      var age = inp.age || 35;
      var income = inp.income || 0;
      var assets = inp.assets || 0;
      var debts = inp.debts || 0;
      var superBal = inp.superBalance || 0;
      var netWorth = assets - debts;

      // Savings pillar (25%): net worth vs income multiple
      var savingsTarget = income * (age / 5);
      var savingsScore = savingsTarget > 0 ? Math.min(100, (netWorth / savingsTarget) * 100) : 50;
      savingsScore = Math.max(0, savingsScore);

      // Debt pillar (25%): debt-to-assets ratio
      var debtRatio = assets > 0 ? debts / assets : 1;
      var debtScore = Math.max(0, Math.min(100, (1 - debtRatio) * 100));

      // Super pillar (20%): vs ASFA benchmark for age
      var asfaBenchmarks = { 25:50000, 30:100000, 35:175000, 40:275000, 45:400000, 50:550000, 55:720000, 60:950000 };
      var benchmark = 0;
      var ages = Object.keys(asfaBenchmarks).map(Number).sort(function(a,b){return a-b;});
      for (var i = 0; i < ages.length; i++) { if (age >= ages[i]) benchmark = asfaBenchmarks[ages[i]]; }
      if (!benchmark) benchmark = 50000;
      var superScore = benchmark > 0 ? Math.min(100, (superBal / benchmark) * 100) : 50;
      superScore = Math.max(0, superScore);

      // Wealth trajectory (15%): assets vs income
      var trajectoryScore = income > 0 ? Math.min(100, (assets / (income * 3)) * 100) : 50;
      trajectoryScore = Math.max(0, trajectoryScore);

      // Protection (15%): assume average (no data)
      var protectionScore = 55;

      var total = Math.round(
        savingsScore * 0.25 +
        debtScore * 0.25 +
        superScore * 0.20 +
        trajectoryScore * 0.15 +
        protectionScore * 0.15
      );

      var pillars = [
        { key: 'savings', label: 'Savings & Net Worth', weight: 25, score: Math.round(savingsScore) },
        { key: 'debt', label: 'Debt Management', weight: 25, score: Math.round(debtScore) },
        { key: 'super', label: 'Superannuation', weight: 20, score: Math.round(superScore) },
        { key: 'trajectory', label: 'Wealth Trajectory', weight: 15, score: Math.round(trajectoryScore) },
        { key: 'protection', label: 'Protection & Insurance', weight: 15, score: protectionScore },
      ];

      return { total: total, netWorth: netWorth, pillars: pillars };
    }

    function scoreBand(v) {
      if (v >= 80) return 'Excellent';
      if (v >= 65) return 'Good';
      if (v >= 50) return 'Fair';
      if (v >= 35) return 'Needs Work';
      return 'At Risk';
    }

    function fmtAUD(n) {
      var abs = Math.abs(n);
      var s;
      if (abs >= 1e6) s = '$' + (n/1e6).toFixed(1) + 'M';
      else if (abs >= 1e3) s = '$' + Math.round(n/1e3) + 'k';
      else s = '$' + n.toFixed(0);
      return s;
    }

    function renderIntro() {
      var html = '<p class="sc-kicker">Free Maal Score</p>';
      html += '<h1 class="sc-h1">Get your free Maal Score.</h1>';
      html += '<p class="sc-intro-body">Answer a few questions about your income, savings, debts, super, HECS and investments. Maal will estimate your financial wellbeing score and show the main drivers behind it.</p>';
      html += '<p class="sc-intro-trust">Takes about two minutes. No bank login required. Educational only — not financial advice.</p>';
      html += '<button class="sc-intro-start" id="sc-intro-start">Get started</button>';
      root.innerHTML = html;

      document.getElementById('sc-intro-start').addEventListener('click', function() {
        introShown = true;
        step = 0;
        renderWizard();
      });
    }

    function renderWizard() {
      var cur = STEPS[step];
      var pct = ((step + 1) / 4) * 100;
      var html = '<p class="sc-kicker">Step ' + (step + 1) + ' of 4 · ' + cur.title + '</p>';
      html += '<h1 class="sc-h1">' + cur.question + '</h1>';
      html += '<div class="sc-progress"><div class="sc-progress-fill" style="width:' + pct + '%"></div></div>';
      html += '<div class="sc-fields">';
      cur.fields.forEach(function(f) {
        html += '<label class="sc-label">';
        html += '<div class="sc-label-row">';
        html += '<span class="sc-label-text">' + f.label + '</span>';
        if (f.prefix || f.suffix) {
          html += '<span class="sc-label-hint-inline">' + (f.prefix || f.suffix) + '</span>';
        }
        html += '</div>';
        html += '<input class="sc-input" type="number" data-key="' + f.key + '"';
        html += ' value="' + inputs[f.key] + '"';
        if (f.min !== undefined) html += ' min="' + f.min + '"';
        if (f.max !== undefined) html += ' max="' + f.max + '"';
        if (f.step) html += ' step="' + f.step + '"';
        html += '>';
        if (f.hint) html += '<p class="sc-hint">' + f.hint + '</p>';
        html += '</label>';
      });
      html += '</div>';
      html += '<div class="sc-nav">';
      html += '<button class="sc-back" id="sc-back-btn">← Back</button>';
      html += '<button class="sc-next" id="sc-next-btn">' + (step === 3 ? 'See my score' : 'Continue') + '</button>';
      html += '</div>';
      html += '<div class="sc-disclaimer">Maal does not provide financial advice. This calculator is for educational purposes only.</div>';
      root.innerHTML = html;

      root.querySelectorAll('.sc-input').forEach(function(inp) {
        inp.addEventListener('change', function() { inputs[inp.dataset.key] = Number(inp.value); });
        inp.addEventListener('input', function() { inputs[inp.dataset.key] = Number(inp.value); });
      });
      document.getElementById('sc-back-btn').addEventListener('click', function() {
        if (step > 0) { step--; renderWizard(); }
        else { renderIntro(); }
      });
      document.getElementById('sc-next-btn').addEventListener('click', function() {
        if (step < 3) { step++; renderWizard(); }
        else { renderResult(); }
      });
    }

    function buildRingPath(value) {
      var R = 72; var cx = 84; var cy = 84;
      var circumference = 2 * Math.PI * R;
      var gap = 24; // degrees of gap at bottom
      var arcDeg = 360 - gap;
      var arcLen = circumference * (arcDeg / 360);
      var filledLen = arcLen * (value / 100);
      var rot = 90 + (gap / 2);
      return { arcLen: arcLen, filledLen: filledLen, circumference: circumference, rot: rot, R: R, cx: cx, cy: cy };
    }

    function renderRing(value) {
      var d = buildRingPath(value);
      var bgColor = 'var(--surface-2)';
      var fgColor = 'var(--fg)';
      return '<svg viewBox="0 0 168 168" width="168" height="168" style="display:block">' +
        '<circle cx="84" cy="84" r="72" fill="none" stroke="' + bgColor + '" stroke-width="10" stroke-dasharray="' + d.arcLen + ' ' + d.circumference + '" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(' + d.rot + ' 84 84)"/>' +
        '<circle id="sc-ring-fill" cx="84" cy="84" r="72" fill="none" stroke="' + fgColor + '" stroke-width="10" stroke-dasharray="' + d.filledLen + ' ' + d.circumference + '" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(' + d.rot + ' 84 84)" style="transition:stroke-dasharray 1.2s cubic-bezier(.2,.8,.2,1)"/>' +
        '</svg>';
    }

    var emailSent = false;

      // Plain-English commentary for the four pillars this calculator actually
      // derives from user input (Protection is a fixed estimate — see below —
      // so it's excluded from the helping/dragging/next-steps narrative to
      // avoid praising or blaming the user for something not based on their answers).
      var HELPING_COPY = {
        savings: 'ahead of where your age and income would suggest',
        debt: 'well managed relative to what you own',
        super: 'tracking well against the ASFA benchmark for your age',
        trajectory: 'growing faster than your income alone would suggest',
      };
      var DRAGGING_COPY = {
        savings: 'behind where your age and income would suggest',
        debt: 'a large share of what you own',
        super: 'behind the ASFA benchmark for your age',
        trajectory: 'not yet keeping pace with your income',
      };
      var NEXT_STEP_COPY = {
        savings: 'How building a cash buffer changes your net worth over time.',
        debt: 'Whether paying down debt faster, or investing the difference, gets you further.',
        super: 'Whether extra super contributions could close the gap to the ASFA benchmark for your age.',
        trajectory: 'How consistent investing compounds over the next 10, 20, 30 years.',
      };

      function renderResult() {
      var res = computeScore(inputs);
      var band = scoreBand(res.total);
      var realPillars = res.pillars.filter(function(p) { return p.key !== 'protection'; });
      var ascending = realPillars.slice().sort(function(a, b) { return a.score - b.score; });
      var descending = realPillars.slice().sort(function(a, b) { return b.score - a.score; });
      var helping = descending.filter(function(p) { return p.score >= 60; }).slice(0, 2);
      if (!helping.length) helping = [descending[0]];
      var dragging = ascending.filter(function(p) { return p.score < 70; }).slice(0, 2);
      var nextSteps = ascending.slice(0, 3);

      var html = '<p class="sc-kicker">Your result</p>';
      html += '<h1 class="sc-h1">Your Maal Score is in.</h1>';

      html += '<div class="sc-result-box">';
      html += '<div class="sc-result-top">';
      html += '<div class="sc-ring-wrap">' + renderRing(res.total) + '<div class="sc-ring-label"><span class="sc-ring-num">' + res.total + '</span><span class="sc-ring-denom">/ 100</span></div></div>';
      html += '<div>';
      html += '<div class="sc-band-pill"><span class="sc-band-dot"></span><span class="sc-band-text">' + band + '</span></div>';
      html += '<p class="sc-result-desc">Based on what you told us, your net worth is <strong>' + fmtAUD(res.netWorth) + '</strong>. Here\'s what\'s helping, what\'s holding you back, and three things worth understanding next.</p>';
      html += '</div>';
      html += '</div>';

      html += '<div class="sc-signal-block">';
      html += '<p class="sc-signal-title sc-signal-title--up">What\'s helping</p>';
      helping.forEach(function(p) {
        html += '<p class="sc-signal-row"><span class="sc-signal-dot sc-signal-dot--up"></span>' + p.label + ' is ' + (HELPING_COPY[p.key] || 'a relative strength') + '.</p>';
      });
      html += '</div>';

      if (dragging.length) {
        html += '<div class="sc-signal-block">';
        html += '<p class="sc-signal-title sc-signal-title--down">What\'s holding you back</p>';
        dragging.forEach(function(p) {
          html += '<p class="sc-signal-row"><span class="sc-signal-dot sc-signal-dot--down"></span>' + p.label + ' is ' + (DRAGGING_COPY[p.key] || 'behind where it could be') + '.</p>';
        });
        html += '</div>';
      }

      html += '<div class="sc-pillars">';
      res.pillars.forEach(function(p) {
        var color = p.score < 50 ? 'var(--gold)' : 'var(--fg)';
        html += '<div>';
        html += '<div class="sc-pillar-row">';
        html += '<span class="sc-pillar-name">' + p.label + ' <span class="sc-pillar-weight">&middot; ' + p.weight + '%</span></span>';
        html += '<span class="sc-pillar-score">' + p.score + '</span>';
        html += '</div>';
        html += '<div class="sc-pillar-bar-bg"><div class="sc-pillar-bar-fill" data-score="' + p.score + '" style="width:0%;background:' + color + '"></div></div>';
        if (p.key === 'protection') html += '<p class="sc-hint" style="margin-top:.35rem;">Estimated — this quick calculator doesn\'t ask about insurance or retirement planning yet.</p>';
        html += '</div>';
      });
      html += '</div>';
      html += '</div>';

      html += '<div class="sc-result-box" style="margin-top:1.25rem;">';
      html += '<p class="sc-next-title">Your next 3 things to understand</p>';
      html += '<ol class="sc-next-list">';
      nextSteps.forEach(function(p) {
        html += '<li>' + (NEXT_STEP_COPY[p.key] || 'How ' + p.label.toLowerCase() + ' affects your score.') + '</li>';
      });
      html += '</ol>';
      html += '<p class="sc-hint" style="margin-top:.75rem;">These are educational prompts, not personal financial advice.</p>';
      html += '</div>';

      if (!emailSent) {
        html += '<div class="sc-email-box" id="sc-email-container">';
        html += '<p class="sc-email-title">Email me my full report — score breakdown, what\'s holding me back, and my next 3 moves.</p>';
        html += '<p class="sc-email-body">We won\'t sell or share your email.</p>';
        html += '<div class="sc-email-row">';
        html += '<input class="sc-email-input" id="sc-email" type="email" placeholder="you@example.com" autocomplete="email">';
        html += '<button class="sc-email-btn" id="sc-email-btn">Email my report</button>';
        html += '</div>';
        html += '</div>';
      } else {
        html += '<div class="sc-email-sent"><p class="sc-email-sent-title">You\'re set.</p><p class="sc-email-sent-body">Your report is queued. <a href="/signup" style="color:var(--fg)">Create an account</a> to track your score over time.</p></div>';
      }

      html += '<div class="sc-result-nav">';
      html += '<button class="sc-restart" id="sc-restart">← Start over</button>';
      html += '<a href="/pricing" style="font-size:13px;font-weight:600;color:var(--fg);text-decoration:none">See pricing →</a>';
      html += '</div>';
      html += '<div class="sc-disclaimer">Maal does not provide financial advice. This calculator is for educational purposes only.</div>';

      root.innerHTML = html;

      // Animate bars
      setTimeout(function() {
        root.querySelectorAll('.sc-pillar-bar-fill').forEach(function(el) {
          el.style.width = el.dataset.score + '%';
        });
      }, 100);

      // Email submit
      var emailBtn = document.getElementById('sc-email-btn');
      if (emailBtn) {
        emailBtn.addEventListener('click', function() {
          var email = document.getElementById('sc-email').value.trim();
          emailBtn.disabled = true;
          emailBtn.textContent = 'Sending…';
          fetch('/score/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              age: inputs.age, income: inputs.income,
              superBalance: inputs.superBalance,
              computed_score: res.total,
              email: email
            })
          }).then(function(resp) {
            emailSent = true;
            var c = document.getElementById('sc-email-container');
            if (c) c.outerHTML = '<div class="sc-email-sent"><p class="sc-email-sent-title">You\'re set.</p><p class="sc-email-sent-body">Your report is queued. <a href="/signup" style="color:var(--fg)">Create an account</a> to track your score over time.</p></div>';
          }).catch(function() {
            emailBtn.disabled = false;
            emailBtn.textContent = 'Email my report';
          });
        });
      }

      // Restart
      document.getElementById('sc-restart').addEventListener('click', function() {
        step = 0;
        renderWizard();
      });
    }

    renderIntro();
  })();
  </script>
</body>
</html>