<div class="page-head">
  <div>
    <h1>Profile</h1>
    <div class="sub">The more Mizan knows, the sharper your education gets.</div>
  </div>
</div>

<% if (success) { %>
<div class="alert alert-success"><%= success %></div>
<% } %>
<% if (error) { %>
<div class="alert alert-error"><%= error %></div>
<% } %>

<div class="panel" style="margin-bottom:1rem;">
  <div class="panel-title">Preferences</div>
  <p style="font-size:0.82rem; color:var(--fg-muted); margin:0 0 0.8rem;">
    Personalise how Mizan responds to you. What should it keep top of mind when answering your questions?
  </p>
  <div style="display:flex; gap:0.45rem; flex-wrap:wrap; margin-bottom:0.8rem;">
    <span class="chip chip-muted">Concise responses</span>
    <span class="chip chip-muted">Tax focus</span>
    <span class="chip chip-muted">Ethical screening</span>
    <span class="chip chip-muted">My situation</span>
  </div>
  <div class="field">
    <textarea rows="3" placeholder='e.g. "Always explain in plain language. I prefer ethical investments and want to maximise super before anything else."'></textarea>
  </div>
</div>

<div class="widget-grid">
  <div class="col-6">

    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Account</div>
      <form action="/dashboard/profile" method="POST">
        <div class="field">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" value="<%= user.name || '' %>" required>
        </div>
        <div class="field">
          <label for="email">Email address</label>
          <input type="email" id="email" value="<%= user.email %>" disabled style="opacity:0.6; cursor:not-allowed;">
        </div>
        <button type="submit" class="btn btn-accent btn-sm">Save changes</button>
      </form>
    </div>

    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">About you</div>
      <div class="field-row">
        <div class="field"><label>Date of birth</label><input type="date"></div>
        <div class="field"><label>Marital status</label><select><option>Select</option><option>Single</option><option>Married / de facto</option></select></div>
      </div>
      <div class="field-row">
        <div class="field"><label>Dependants</label><input type="number" value="0" min="0"></div>
        <div class="field"><label>Residency for tax</label><select><option>Australian resident</option><option>Foreign resident</option><option>Working holiday maker</option></select></div>
      </div>
    </div>

    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Work &amp; income</div>
      <div class="field-row">
        <div class="field"><label>Profession</label><input type="text" value="<%= (profile && profile.profession) || '' %>" placeholder="e.g. Doctor, Pharmacist"></div>
        <div class="field"><label>Years in practice</label><input type="number" value="<%= (profile && profile.years_in_practice) || '' %>" min="0"></div>
      </div>
      <div class="field-row">
        <div class="field"><label>Annual gross income (AUD)</label><input type="text" value="<%= (profile && profile.annual_income) ? '$' + profile.annual_income.toLocaleString('en-AU') : '' %>" placeholder="$120,000"></div>
        <div class="field"><label>Expected retirement age</label><input type="number" value="<%= (profile && profile.retirement_age) || 65 %>"></div>
      </div>
      <a href="/onboarding" class="btn btn-ghost btn-sm">Edit onboarding data</a>
    </div>

  </div>

  <div class="col-6">

    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Tax settings <span class="chip chip-accent">ATO</span></div>
      <div class="field-row">
        <div class="field"><label>State / Territory</label><select><option>NSW</option><option>VIC</option><option>QLD</option><option>WA</option><option>SA</option><option>TAS</option><option>ACT</option><option>NT</option></select></div>
        <div class="field"><label>HECS-HELP balance</label><input type="text" value="<%= (profile && profile.hecs_balance) ? '$' + profile.hecs_balance.toLocaleString('en-AU') : '' %>" placeholder="$0"></div>
      </div>
      <div class="field-row">
        <div class="field"><label>Private health cover</label><select><option>Yes</option><option>No (MLS may apply)</option></select></div>
        <div class="field"><label>Salary sacrifice to super</label><input type="text" placeholder="$0 / fortnight"></div>
      </div>
    </div>

    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Superannuation</div>
      <div class="field-row">
        <div class="field"><label>Super fund</label><select><option>Select fund</option><option>AustralianSuper</option><option>HESTA</option><option>Hostplus</option><option>Aware Super</option><option>UniSuper</option><option>Rest</option><option>Other / SMSF</option></select></div>
        <div class="field"><label>Balance</label><input type="text" value="<%= (profile && profile.super_balance) ? '$' + profile.super_balance.toLocaleString('en-AU') : '' %>" placeholder="$0"></div>
      </div>
      <div class="field"><label>Investment option</label><select><option>Balanced</option><option>Growth</option><option>High Growth</option><option>Conservative</option><option>Ethical / sustainable option</option></select></div>
    </div>

    <div class="panel" style="margin-bottom:1rem;">
      <div class="panel-title">Investing profile</div>
      <div class="field-row">
        <div class="field"><label>Risk tolerance</label><select><option>Select</option><option>Conservative</option><option>Balanced</option><option>Growth</option><option>Aggressive</option></select></div>
        <div class="field"><label>Experience</label><select><option>Select</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></div>
      </div>
      <div class="field"><label>Ethical screening</label>
        <select>
          <option <%= (profile && profile.prefers_halal) ? 'selected' : '' %>>Halal framework</option>
          <option <%= (profile && profile.prefers_esg) ? 'selected' : '' %>>ESG / ethical framework</option>
          <option>Both</option>
          <option>No screening</option>
        </select>
      </div>
    </div>

    <div class="panel" style="border-color:rgba(214,84,74,0.35);">
      <div class="panel-title" style="color:var(--danger);">Danger zone</div>
      <p style="font-size:0.8rem; color:var(--fg-muted); margin:0 0 0.9rem; line-height:1.6;">
        Deleting your account permanently removes all data, scores and history. This cannot be undone.
      </p>
      <button class="btn btn-danger-soft btn-sm" id="delete-account-btn">Delete my account</button>
    </div>

  </div>
</div>

<script>
  document.getElementById('delete-account-btn') && document.getElementById('delete-account-btn').addEventListener('click', function() {
    if (confirm('Are you sure you want to delete your account? This is irreversible.')) {
      if (confirm('Really delete? All your data will be permanently removed.')) {
        fetch('/api/account/delete', { method: 'POST' }).then(function() { window.location.href = '/'; });
      }
    }
  });
</script>
