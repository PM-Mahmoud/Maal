<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <title>Contact — Maal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { background: var(--bg); min-height: 100vh; display: flex; flex-direction: column; }
    main { flex: 1; }
    .ct-section { padding: 5rem 1.5rem 2rem; text-align: center; }
    .ct-kicker { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .18em; color: var(--fg-muted); margin-bottom: 1rem; }
    .ct-h1 { font-size: clamp(2.2rem,6vw,3rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.05; }
    .ct-sub { margin: 1.25rem auto 0; font-size: 1rem; color: var(--fg-muted); max-width: 480px; line-height: 1.65; }
    .ct-wrap { max-width: 460px; margin: 2.5rem auto 4rem; padding: 0 1.5rem; }
    .ct-form { display: flex; flex-direction: column; gap: .75rem; }
    .ct-input, .ct-textarea { width: 100%; padding: .75rem .875rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); font-size: 14px; font-family: var(--font-body); color: var(--fg); outline: none; box-sizing: border-box; transition: border-color .15s; }
    .ct-input { height: 44px; }
    .ct-textarea { min-height: 120px; resize: vertical; }
    .ct-input:focus, .ct-textarea:focus { border-color: var(--fg); }
    .ct-submit { height: 44px; border-radius: 8px; background: var(--fg); color: #fff; font-size: 13px; font-weight: 600; border: none; cursor: pointer; font-family: var(--font-body); transition: opacity .15s; }
    .ct-submit:hover { opacity: .88; }
    .ct-success { padding: .75rem .875rem; background: var(--accent-soft); border: 1px solid rgba(18,181,166,.25); border-radius: 8px; font-size: 13px; color: var(--fg); margin-bottom: 1rem; }
    .ct-email { text-align: center; margin-top: 2rem; font-size: 13px; color: var(--fg-muted); }
    .ct-email a { color: var(--fg); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    .disclaimer-block { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem; font-size: 11px; color: var(--fg-muted); line-height: 1.8; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="ct-section">
      <p class="ct-kicker">Contact</p>
      <h1 class="ct-h1">Talk to us.</h1>
      <p class="ct-sub">Questions, feedback, or want to talk to the team? Send us a message.</p>
    </section>

    <div class="ct-wrap">
      <% if (locals.success) { %><div class="ct-success">Thanks — we've received your message and will get back to you soon.</div><% } %>
      <form action="/contact" method="POST" class="ct-form">
        <input class="ct-input" type="text" name="name" placeholder="Your name" required value="<%= locals.name || '' %>">
        <input class="ct-input" type="email" name="email" placeholder="you@example.com" required value="<%= locals.email || '' %>">
        <textarea class="ct-textarea" name="message" placeholder="How can we help?" required><%= locals.message || '' %></textarea>
        <button type="submit" class="ct-submit">Send message</button>
      </form>
      <p class="ct-email">Or email us directly at <a href="mailto:hello@hellomaal.com">hello@hellomaal.com</a></p>
    </div>

    <div class="disclaimer-block">
      DISCLAIMER: Maal does not provide financial advice. Any information provided by Maal is for educational purposes only. You should do your own research. Investing is risky and you can lose all of your money.
    </div>
  </main>

  <%- include('partials/footer') %>
  <%- analyticsSnippet %>
</body>
</html>
