<div class="page-header">
  <h1>Your Maal Score</h1>
  <p>The same score shown on your dashboard — savings, debt, super, wealth trajectory and protection, in one number.</p>
</div>

<% if (!profile || !profile.completed_onboarding) { %>
<div class="empty-state">
  <div class="icon">◈</div>
  <h3>Complete onboarding to see your score</h3>
  <p>Answer a few questions about your finances to get your personalised score.</p>
  <a href="/onboarding" class="btn-primary">Start onboarding</a>
</div>
<% } else { %>

<%
  var mz = (typeof maalScore !== 'undefined' && maalScore) ? maalScore : { score: 0, band: '—', pillars: [], hasData: false };
  var bandChip = mz.score >= 65 ? 'chip-accent' : mz.score >= 50 ? 'chip-gold' : mz.score >= 35 ? 'chip-warn' : 'chip-danger';
%>

<div class="card" style="margin-bottom:1.5rem;text-align:center;">
  <div class="score-card-label">Maal Score</div>
  <div class="score-card-big"><%= mz.hasData ? mz.score : '—' %><span class="score-card-max">/100</span></div>
  <% if (mz.hasData) { %><span class="chip <%= bandChip %>"><%= mz.band %></span><% } %>
  <p style="font-size:0.85rem;color:var(--fg-muted);margin-top:0.75rem;max-width:480px;margin-left:auto;margin-right:auto;">
    <%= mz.hasData
        ? 'Your financial wellbeing in one number — savings, debt, super, wealth and protection, weighted the way researchers measure financial health.'
        : 'Add income and assets to calculate your score.' %>
  </p>
</div>

<div style="margin-bottom:1.5rem;display:flex;align-items:center;flex-wrap:wrap;gap:0.75rem;">
  <form action="/dashboard/scores/recalculate" method="POST" style="display:inline;">
    <button type="submit" class="btn-primary">Recalculate now</button>
  </form>
  <span style="font-size:0.78rem;color:var(--fg-muted);">
    Updates automatically as you add assets or connect accounts (at most once an hour) — or recalculate instantly above.
  </span>
</div>

<% if (mz.hasData && mz.pillars && mz.pillars.length) { %>
<div class="card">
  <div class="card-title">Score breakdown — five pillars</div>
  <% mz.pillars.forEach(function(pl) { %>
    <div class="breakdown-row">
      <div>
        <span class="breakdown-label"><%= pl.label %> <span style="color:var(--fg-muted);font-weight:400;">(<%= Math.round(pl.weight * 100) %>%)</span></span>
        <div style="font-size:0.725rem;color:var(--fg-muted);opacity:0.7;margin-top:0.15rem;"><%= pl.note || '' %></div>
      </div>
      <div style="display:flex;align-items:center;gap:0.75rem;margin-left:1rem;">
        <div class="bar-track" style="width:100px;"><div class="bar-fill" style="width:<%= pl.score %>%; <%= pl.score < 40 ? 'background:var(--warn);' : '' %>"></div></div>
        <span class="breakdown-val"><%= pl.score %>/100</span>
      </div>
    </div>
  <% }); %>
</div>
<% } %>

<% if (maalHistory && maalHistory.length > 1) { %>
<div class="card">
  <div class="card-title">Score history (last <%= maalHistory.length %> calculations)</div>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:0.825rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="text-align:left;padding:0.5rem 0.5rem 0.5rem;color:var(--fg-muted);font-weight:500;">Date</th>
          <th style="text-align:right;padding:0.5rem;color:var(--fg-muted);font-weight:500;">Maal Score</th>
          <th style="text-align:right;padding:0.5rem;color:var(--fg-muted);font-weight:500;">Band</th>
        </tr>
      </thead>
      <tbody>
        <% maalHistory.forEach(function(s) { %>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.06);">
            <td style="padding:0.55rem 0.5rem;color:var(--fg-muted);"><%= new Date(s.calculated_at).toLocaleDateString('en-AU', {day:'numeric',month:'short',year:'numeric'}) %></td>
            <td style="text-align:right;padding:0.55rem;color:var(--fg);font-weight:600;"><%= s.score_value %>/100</td>
            <td style="text-align:right;padding:0.55rem;"><span class="grade-pill" style="font-size:0.65rem;"><%= s.grade || '' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="card" style="margin-top:1.5rem;">
  <div class="card-title">What this score is — and isn't</div>
  <p style="font-size:0.825rem;color:var(--fg-muted);line-height:1.7;">
    The Maal Score is general information for educational purposes only, based on the profile and account data you've provided — it is not personal financial advice and doesn't take into account objectives, financial situation or needs beyond what you've told Maal. It isn't a credit score and has no effect on your credit file.
  </p>
</div>

<% } %>
