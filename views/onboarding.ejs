  // ── Step navigation ──────────────────────────────────────────────────────────
  function nextStep() {
    if (!validateStep(currentStep)) return;

    saveCurrentStep(currentStep);

    if (currentStep < TOTAL_STEPS) {
      currentStep++;
      renderStep(currentStep);
      updateProgress();
      updateNavButtons(currentStep);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      submitOnboarding();
    }
  }

  function prevStep() {
    if (currentStep > 1) {
      saveCurrentStep(currentStep);
      currentStep--;
      renderStep(currentStep);
      updateProgress();
      updateNavButtons(currentStep);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  function updateNavButtons(n) {
    const back = document.getElementById('btnBack');
    back.style.visibility = n > 1 ? 'visible' : 'hidden';
    const next = document.getElementById('btnNext');
    next.innerHTML = n === TOTAL_STEPS ? 'Get My Score →' : 'Continue →';
  }

  // ── Validation ────────────────────────────────────────────────────────────────
  function validateStep(n) {
    switch (n) {
      case 1: {
        const role = document.getElementById('role');
        const loc = document.getElementById('location');
        let ok = true;
        if (!role.value) { document.getElementById('roleError').classList.add('show'); role.classList.add('error'); ok = false; }
        if (!loc.value.trim()) { document.getElementById('locationError')?.classList.add('show'); loc?.classList.add('error'); ok = false; }
        const incomeChecked = document.querySelector('#incomeRange input:checked');
        if (!incomeChecked) { document.getElementById('incomeRangeError')?.classList.add('show'); ok = false; }
        const goalChecked = document.querySelector('#investmentGoal input:checked');
        if (!goalChecked) { document.getElementById('investmentGoalError')?.classList.add('show'); ok = false; }
        return ok;
      }
      default: return true;
    }
  }

  function validateField(id) {
    const el = document.getElementById(id);
    if (!el) return true;
    const err = document.getElementById(id + 'Error');
    if (!el.value.trim()) {
      el.classList.add('error');
      err?.classList.add('show');
      return false;
    }
    el.classList.remove('error');
    err?.classList.remove('show');
    return true;
  }

  // ── Radio / checkbox helpers ─────────────────────────────────────────────────
  function selectRadio(groupId, label, value) {
    const items = document.querySelectorAll(`#${groupId} .radio-item`);
    items.forEach(i => i.classList.remove('selected'));
    label.classList.add('selected');
    label.querySelector('input').checked = true;
    const err = document.getElementById(groupId + 'Error');
    err?.classList.remove('show');
  }

  function toggleInlineCheck(el) {
    el.classList.toggle('selected');
    el.querySelector('input').checked = el.classList.contains('selected');
  }

  function toggleTooltip(btn) {
    const pop = btn.querySelector('.tooltip-pop');
    if (!pop) return;
    document.querySelectorAll('.tooltip-pop').forEach(p => { if (p !== pop) p.classList.remove('show'); });
    pop.classList.toggle('show');
  }

  // ── Dynamic list rows ─────────────────────────────────────────────────────────
  function addBrokerageRow() {
    const list = document.getElementById('brokerageList');
    const row = document.createElement('div');
    row.className = 'list-row';
    row.setAttribute('data-row', list.children.length);
    row.innerHTML = `
      <select class="field-select" style="font-size:0.85rem;">
        <option value="">Select provider…</option>
        <option value="commsec">CommSec</option>
        <option value="nabtrade">NabTrade</option>
        <option value="selfwealth">SelfWealth</option>
        <option value="cmc">CMC Markets</option>
        <option value="ib">Interactive Brokers</option>
        <option value="other">Other</option>
      </select>
      <input class="field-input" type="number" min="0" placeholder="Approx. balance ($)" style="font-size:0.85rem;" />
      <button class="btn-remove" onclick="removeRow(this)" title="Remove">×</button>
    `;
    list.appendChild(row);
  }

  function removeRow(btn) {
    const row = btn.closest('[data-row]');
    if (document.querySelectorAll('[data-row]').length > 1) {
      row.remove();
    }
  }

  // ── Save / load ───────────────────────────────────────────────────────────────
  function saveCurrentStep(step) {
    const data = collectFormData();
    savedData[step] = data;
    savedData['currentStep'] = step;
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(savedData)); } catch(e) {}
    if (sessionId) {
      fetch(`/api/onboarding/step/${step}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ session_id: sessionId, ...data })
      }).catch(console.error);
    }
  }

  function collectFormData() {
    const data = {};

    // Text / number inputs
    ['role', 'yearsInPractice', 'location', 'superFundName', 'superBalance', 'superFundType',
     'hecsBalance', 'hecsRemaining', 'mortgageBalance', 'mortgageLvr',
     'investmentPropertyDebt', 'otherPersonalDebt', 'directShares',
     'cryptoHoldings', 'otherAssets', 'targetRetirementAge', 'targetNestEgg', 'specificGoals'].forEach(id => {
      const el = document.getElementById(id);
      if (el) data[id] = el.value;
    });

    // Radio groups
    const radios = document.querySelectorAll('input[type="radio"]:checked');
    radios.forEach(r => { data[r.name] = r.value; });

    // Brokerage list
    const rows = document.querySelectorAll('#brokerageList [data-row]');
    data.brokerageAccounts = Array.from(rows).map(row => ({
      provider: row.querySelector('select')?.value || '',
      balance: row.querySelector('input[type="number"]')?.value || ''
    })).filter(r => r.provider);

    return data;
  }

  function loadFromStorage() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) savedData = JSON.parse(stored);
    } catch(e) {}
  }

  function restoreSavedData(step) {
    const stepData = savedData[step] || savedData;
    if (!stepData || Object.keys(stepData).length === 0) return;

    // Restore text/number fields
    Object.keys(stepData).forEach(key => {
      const el = document.getElementById(key);
      if (el && el.type !== 'radio' && el.type !== 'checkbox') {
        el.value = stepData[key];
      }
    });

    // Restore radios
    if (stepData.income_range) {
      const item = document.querySelector(`#incomeRange .radio-item input[value="${stepData.income_range}"]`);
      if (item) { item.checked = true; item.closest('.radio-item').classList.add('selected'); }
    }
    if (stepData.investment_goal) {
      const item = document.querySelector(`#investmentGoal .radio-item input[value="${stepData.investment_goal}"]`);
      if (item) { item.checked = true; item.closest('.radio-item').classList.add('selected'); }
    }
    if (stepData.employment_type) {
      const item = document.querySelector(`#employmentType .radio-item input[value="${stepData.employment_type}"]`);
      if (item) { item.checked = true; item.closest('.radio-item').classList.add('selected'); }
    }
    if (stepData.tfn_lodged) {
      const item = document.querySelector(`#tfnLodged .radio-item input[value="${stepData.tfn_lodged}"]`);
      if (item) { item.checked = true; item.closest('.radio-item').classList.add('selected'); }
    }
    if (stepData.super_contribution) {
      const item = document.querySelector(`#superContribution .radio-item input[value="${stepData.super_contribution}"]`);
      if (item) { item.checked = true; item.closest('.radio-item').classList.add('selected'); }
    }
    if (stepData.risk_tolerance) {
      const item = document.querySelector(`#riskTolerance .radio-item input[value="${stepData.risk_tolerance}"]`);
      if (item) { item.checked = true; item.closest('.radio-item').classList.add('selected'); }
    }

    // Restore brokerage rows
    if (stepData.brokerageAccounts && stepData.brokerageAccounts.length > 0) {
      const list = document.getElementById('brokerageList');
      if (list) {
        list.innerHTML = '';
        stepData.brokerageAccounts.forEach((acc, i) => {
          const row = document.createElement('div');
          row.className = 'list-row';
          row.setAttribute('data-row', i);
          row.innerHTML = `
            <select class="field-select" style="font-size:0.85rem;">
              <option value="">Select provider…</option>
              <option value="commsec" ${acc.provider==='commsec'?'selected':''}>CommSec</option>
              <option value="nabtrade" ${acc.provider==='nabtrade'?'selected':''}>NabTrade</option>
              <option value="selfwealth" ${acc.provider==='selfwealth'?'selected':''}>SelfWealth</option>
              <option value="cmc" ${acc.provider==='cmc'?'selected':''}>CMC Markets</option>
              <option value="ib" ${acc.provider==='ib'?'selected':''}>Interactive Brokers</option>
              <option value="other" ${acc.provider==='other'?'selected':''}>Other</option>
            </select>
            <input class="field-input" type="number" min="0" placeholder="Approx. balance ($)" style="font-size:0.85rem;" value="${acc.balance || ''}" />
            <button class="btn-remove" onclick="removeRow(this)" title="Remove">×</button>
          `;
          list.appendChild(row);
        });
      }
    }
  }

  // ── Submit ────────────────────────────────────────────────────────────────────
  async function submitOnboarding() {
    saveCurrentStep(TOTAL_STEPS);

    let resultData = null;
    if (sessionId) {
      try {
        const res = await fetch('/api/onboarding/complete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ session_id: sessionId })
        });
        if (res.ok) {
          resultData = await res.json();
        }
      } catch(e) {
        console.error('Completion fetch error:', e);
      }
    }

    // Show completion screen with live scores
    const card = document.getElementById('stepCard');
    const gradeColor = { 'Excellent': '#7ED4A6', 'Good': '#C9A84C', 'Fair': '#C9963C', 'Needs Work': '#E07070', 'Critical': '#E07070' };
    const gc = gradeColor[resultData?.grade] || '#C9A84C';

    let scoreHTML = '';
    if (resultData && resultData.ok) {
      scoreHTML = `
        <div style="margin:1.5rem 0;">
          <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:1.1rem;text-align:center;border:1px solid var(--border);">
            <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.08em;color:#8A8D83;margin-bottom:0.5rem;">Financial Health Score</div>
            <div style="font-size:2rem;font-weight:700;color:${gc};">${resultData.score}<span style="font-size:1rem;color:#8A8D83;">/100</span></div>
            <div style="font-size:0.75rem;color:#7ED4A6;margin-top:0.3rem;">${resultData.grade}</div>
          </div>
        </div>
        <p style="font-size:0.85rem;color:#8A8D83;margin-bottom:0.75rem;text-align:center;">Your score is saved to your dashboard and the full breakdown is in your inbox.</p>
      `;
    }

    card.innerHTML = `
      <div class="step-completion">
        <div class="big-icon">✦</div>
        <h2>${resultData && resultData.ok ? "You're all set — " + resultData.grade : "You're all set!"}</h2>
        <p>${resultData && resultData.ok ? "Your financial health profile is complete and your scores have been calculated and saved." : "Your financial health profile is complete. Your results will be emailed to you shortly."}</p>
        ${scoreHTML}
        <div class="completion-actions">
          <button class="btn-primary-lg" onclick="window.location.href='/dashboard'">View My Dashboard →</button>
          <a class="save-later-link" href="/">Back to home</a>
        </div>
      </div>
    `;
    document.getElementById('stepNav').style.display = 'none';
    document.getElementById('progressFill').classList.add('complete');
    document.getElementById('progressFill').style.width = '100%';
    document.getElementById('progressPct').textContent = '100%';
    document.getElementById('stepLabel').textContent = 'Complete';
    document.getElementById('stepTitle').textContent = 'All Done!';
    document.getElementById('stepSub').textContent = resultData?.ok ? 'Scores calculated and saved.' : 'Your scores are on the way.';
    updateDots();

    // Clear storage
    try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
  }

  // ── Close tooltips on outside click ──────────────────────────────────────────
  document.addEventListener('click', e => {
    if (!e.target.closest('.tooltip-btn')) {
      document.querySelectorAll('.tooltip-pop').forEach(p => p.classList.remove('show'));
    }
  });

  init();
</script>
</body>
</html>