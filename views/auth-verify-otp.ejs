<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <title>Verify your email — Mizan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1rem; }
    .auth-card { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 2.5rem; width: 100%; max-width: 420px; }
    .auth-logo { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--accent); margin-bottom: 2rem; }
    .auth-card h1 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; margin: 0 0 0.5rem; }
    .auth-card p { font-size: 0.875rem; color: var(--fg-muted); margin: 0 0 2rem; line-height: 1.6; }
    .otp-inputs { display: flex; gap: 0.6rem; justify-content: center; margin-bottom: 1.75rem; }
    .otp-inputs input {
      width: 52px; height: 60px; text-align: center; font-size: 1.5rem; font-weight: 600;
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
      color: var(--fg); font-family: var(--font-body); outline: none;
      transition: border-color 0.2s, background 0.2s; caret-color: var(--accent);
    }
    .otp-inputs input:focus { border-color: var(--accent); background: rgba(201,168,76,0.06); }
    .otp-inputs input.filled { border-color: rgba(201,168,76,0.4); }
    .btn-primary { width: 100%; background: var(--accent); color: #fff; font-weight: 600;
      font-size: 0.95rem; padding: 0.85rem; border: none; border-radius: 10px;
      cursor: pointer; font-family: var(--font-body); transition: opacity 0.2s; }
    .btn-primary:hover { opacity: 0.88; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .alert-error { background: var(--danger-soft); border: 1px solid rgba(224,112,112,0.3);
      color: var(--danger); padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.875rem; margin-bottom: 1.25rem; }
    .resend-row { text-align: center; margin-top: 1.25rem; font-size: 0.825rem; color: var(--fg-muted); }
    .resend-row a, .resend-row button { color: var(--accent); background: none; border: none;
      cursor: pointer; font-family: var(--font-body); font-size: 0.825rem; padding: 0; }
    .resend-row a:hover, .resend-row button:hover { text-decoration: underline; }
    #resendTimer { color: var(--fg-muted); }
    .divider { display: flex; align-items: center; gap: 0.75rem; margin: 1.25rem 0; color: var(--fg-muted); font-size: 0.8rem; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .btn-sms { width: 100%; background: transparent; border: 1px solid var(--border); color: var(--fg);
      font-size: 0.875rem; font-weight: 500; padding: 0.75rem; border-radius: 10px; cursor: pointer;
      font-family: var(--font-body); transition: border-color 0.2s, background 0.2s; display: flex;
      align-items: center; justify-content: center; gap: 0.5rem; }
    .btn-sms:hover { border-color: var(--accent); background: var(--surface-2); }
    .btn-sms:disabled { opacity: 0.5; cursor: not-allowed; }
    #smsStatus { text-align: center; font-size: 0.8rem; margin-top: 0.5rem; min-height: 1.2em; }
  </style>
</head>
<body>
  <div class="auth-card">
    <div class="auth-logo">◈ Mizan</div>
    <h1>Check your email</h1>
    <p>We sent a 6-digit code to <strong style="color:var(--fg)"><%= email %></strong>. Enter it below to verify your account.</p>

    <% if (error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/verify-email" id="otpForm">
      <input type="hidden" name="email" value="<%= email %>">
      <input type="hidden" name="code" id="codeHidden">

      <div class="otp-inputs" id="otpInputs">
        <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" autocomplete="off">
        <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" autocomplete="off">
        <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" autocomplete="off">
        <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" autocomplete="off">
        <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" autocomplete="off">
        <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" autocomplete="off">
      </div>

      <button type="submit" class="btn-primary" id="btnVerify" disabled>Verify email</button>
    </form>

    <div class="resend-row">
      <span id="resendTimer">Resend code in <span id="countdown">60</span>s</span>
      <button id="btnResend" style="display:none" onclick="resendEmail()">Resend to email</button>
    </div>

    <div class="divider">or</div>

    <button class="btn-sms" id="btnSms" onclick="resendSms()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.09 9.81a19.79 19.79 0 01-3.07-8.67A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"></path></svg>
      Send code via SMS instead
    </button>
    <div id="smsStatus"></div>
  </div>

  <script>
    const digits = document.querySelectorAll('.otp-digit');
    const hidden = document.getElementById('codeHidden');
    const btn = document.getElementById('btnVerify');

    digits.forEach((d, i) => {
      d.addEventListener('input', e => {
        const val = e.target.value.replace(/\D/g, '');
        e.target.value = val;
        if (val && i < 5) digits[i + 1].focus();
        syncCode();
      });
      d.addEventListener('keydown', e => {
        if (e.key === 'Backspace' && !e.target.value && i > 0) {
          digits[i - 1].focus();
          digits[i - 1].value = '';
          syncCode();
        }
      });
      d.addEventListener('paste', e => {
        e.preventDefault();
        const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
        paste.split('').forEach((ch, j) => { if (digits[j]) digits[j].value = ch; });
        if (paste.length > 0) digits[Math.min(paste.length, 5)].focus();
        syncCode();
      });
    });

    function syncCode() {
      const code = Array.from(digits).map(d => d.value).join('');
      hidden.value = code;
      btn.disabled = code.length < 6;
      digits.forEach(d => d.classList.toggle('filled', d.value !== ''));
    }

    // Countdown timer for resend
    let seconds = 60;
    const countdownEl = document.getElementById('countdown');
    const timerEl = document.getElementById('resendTimer');
    const resendBtn = document.getElementById('btnResend');
    const timer = setInterval(() => {
      seconds--;
      countdownEl.textContent = seconds;
      if (seconds <= 0) {
        clearInterval(timer);
        timerEl.style.display = 'none';
        resendBtn.style.display = 'inline';
      }
    }, 1000);

    async function resendEmail() {
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending…';
      try {
        const res = await fetch('/resend-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: '<%= email %>' })
        });
        const data = await res.json();
        resendBtn.textContent = data.ok ? 'Sent!' : 'Try again';
        if (data.ok) setTimeout(() => { resendBtn.textContent = 'Resend to email'; resendBtn.disabled = false; }, 3000);
        else resendBtn.disabled = false;
      } catch(e) {
        resendBtn.textContent = 'Try again';
        resendBtn.disabled = false;
      }
    }

    async function resendSms() {
      const smsBtn = document.getElementById('btnSms');
      const smsStatus = document.getElementById('smsStatus');
      smsBtn.disabled = true;
      smsStatus.style.color = 'var(--fg-muted)';
      smsStatus.textContent = 'Sending SMS…';
      try {
        const res = await fetch('/resend-otp-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: '<%= email %>' })
        });
        const data = await res.json();
        if (data.ok) {
          smsStatus.style.color = '#7ED4A6';
          smsStatus.textContent = 'Code sent to your phone!';
          setTimeout(() => { smsBtn.disabled = false; smsStatus.textContent = ''; }, 30000);
        } else {
          smsStatus.style.color = '#E07070';
          smsStatus.textContent = data.error || 'Failed to send SMS.';
          smsBtn.disabled = false;
        }
      } catch(e) {
        smsStatus.style.color = '#E07070';
        smsStatus.textContent = 'Something went wrong.';
        smsBtn.disabled = false;
      }
    }

    digits[0].focus();
  </script>
</body>
</html>
