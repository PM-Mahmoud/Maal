<%
  // Code entry — v2. One generic screen for every 6-digit code step:
  //   purpose 'verify' — confirming a new account's email (sign-up)
  //   purpose 'login'  — passwordless sign-in or email two-factor at sign-in
  // A future authenticator-app (TOTP) step can reuse it by passing its own
  // heading / subtitle / action / submitLabel and resend:false, sms:false.
  // Locals: email, error, purpose, and the optional overrides above.
  const purpose = locals.purpose || 'verify';
  const isLogin = purpose === 'login';
  const heading = locals.heading || (isLogin ? 'Enter your sign-in code' : 'Check your email');
  const submitLabel = locals.submitLabel || (isLogin ? 'Sign in' : 'Verify email');
  const action = locals.action || '/verify-email';
  const allowResend = locals.resend !== false;
  const allowSms = locals.sms !== undefined ? !!locals.sms : !isLogin;
  const email = locals.email || '';
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/v2-head', { title: heading }) %>
</head>
<body class="v2 v2-focus-page">
<%- include('partials/v2-focus-header', { back: locals.back || '/login' }) %>
  <main class="v2-focus">
    <div class="v2-focus-inner">
      <%- include('partials/v2-icon', { name: locals.icon || (isLogin ? 'shield' : 'mail') }) %>
      <h1><%= heading %></h1>
      <p class="v2-focus-sub">
        <% if (locals.subtitle) { %><%= subtitle %>
        <% } else { %>We sent a 6-digit code to <strong><%= email %></strong>. <%= isLogin ? 'Enter it below to sign in.' : 'Enter it below to confirm your email.' %> It expires in 10 minutes.<% } %>
      </p>

      <% if (locals.error) { %><div class="v2-alert" role="alert"><%= error %></div><% } %>

      <form method="POST" action="<%= action %>" id="otp-form" class="v2-focus-form">
        <input type="hidden" name="email" value="<%= email %>">
        <input type="hidden" name="code" id="code-hidden">
        <div class="v2-otp" data-otp data-target="code-hidden" role="group" aria-label="6-digit code">
          <% for (let i = 0; i < 6; i++) { %><input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="<%= i === 0 ? 6 : 1 %>" <%- i === 0 ? 'autocomplete="one-time-code"' : 'autocomplete="off"' %> aria-label="Digit <%= i + 1 %>"><% } %>
        </div>
        <div class="v2-focus-actions"><button type="submit" class="v2-btn v2-btn-ink" id="otp-submit" disabled><%= submitLabel %></button></div>
      </form>

      <% if (allowResend) { %>
      <p class="v2-switch" id="resend-row" data-email="<%= email %>">
        <span id="resend-timer">You can resend the code in <span id="countdown">60</span>s</span>
        <button type="button" class="v2-linkbtn" id="btn-resend" hidden>Resend code</button>
        <span id="resend-status" class="v2-status" aria-live="polite"></span>
      </p>
      <% } %>
      <% if (allowSms) { %>
      <p class="v2-switch">No email? <button type="button" class="v2-linkbtn" id="btn-sms">Text me a code instead</button> <span id="sms-status" class="v2-status" aria-live="polite"></span></p>
      <% } %>
    </div>
  </main>
<%- include('partials/v2-focus-footer') %>
  <script src="/js/v2-auth.js"></script>
  <script>
  (function () {
    var submit = document.getElementById('otp-submit');
    var boxes = window.MaalAuth.otpBoxes(document.querySelector('[data-otp]'), function (code) {
      submit.disabled = code.length < 6;
    });
    document.getElementById('otp-form').addEventListener('submit', function () {
      submit.disabled = true;
    });

    var row = document.getElementById('resend-row');
    var email = row ? row.getAttribute('data-email') : '';
    function post(url) {
      return fetch(url, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email })
      }).then(function (r) { return r.json().catch(function () { return {}; }); });
    }

    if (row) {
      var seconds = 60;
      var timer = document.getElementById('resend-timer');
      var countdown = document.getElementById('countdown');
      var resend = document.getElementById('btn-resend');
      var status = document.getElementById('resend-status');
      var tick = setInterval(function () {
        seconds--;
        countdown.textContent = seconds;
        if (seconds <= 0) { clearInterval(tick); timer.hidden = true; resend.hidden = false; }
      }, 1000);
      resend.addEventListener('click', function () {
        resend.disabled = true;
        status.textContent = 'Sending…';
        post('/resend-otp').then(function (d) {
          status.textContent = d.ok ? 'New code sent.' : (d.error || 'Couldn’t send. Try again shortly.');
          setTimeout(function () { resend.disabled = false; status.textContent = ''; }, d.ok ? 30000 : 3000);
        }).catch(function () { status.textContent = 'Couldn’t send. Try again shortly.'; resend.disabled = false; });
      });
    }

    var sms = document.getElementById('btn-sms');
    if (sms) {
      var smsStatus = document.getElementById('sms-status');
      sms.addEventListener('click', function () {
        sms.disabled = true;
        smsStatus.textContent = 'Sending…';
        post('/resend-otp-sms').then(function (d) {
          smsStatus.textContent = d.ok ? 'Code sent to your phone.' : (d.error || 'Couldn’t send a text.');
          setTimeout(function () { sms.disabled = false; }, d.ok ? 30000 : 0);
        }).catch(function () { smsStatus.textContent = 'Something went wrong.'; sms.disabled = false; });
      });
    }
    boxes.focus();
  })();
  </script>
</body>
</html>
