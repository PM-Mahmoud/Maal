<div class="page-header">
  <h1>History</h1>
  <p>A timeline of your score calculations and recommendations.</p>
</div>

<div style="margin-bottom:1.5rem;">
  <button onclick="window.print()" class="btn-secondary">Export as PDF</button>
</div>

<% if (scores && scores.length) { %>
<div class="card">
  <div class="card-title">Score timeline</div>
  <div class="timeline">
    <% scores.forEach(function(s) { %>
      <div class="timeline-item">
        <div class="timeline-date"><%= new Date(s.calculated_at).toLocaleDateString('en-AU', { weekday:'short', day:'numeric', month:'short', year:'numeric' }) %> at <%= new Date(s.calculated_at).toLocaleTimeString('en-AU', { hour:'2-digit', minute:'2-digit' }) %></div>
        <div class="timeline-title">
          <%= s.score_type === 'financial_health' ? 'Financial Health Score' : s.score_type === 'ethical_score' ? 'Ethical Score' : s.score_type === 'super_health' ? 'Super Health Score' : s.score_type %>: <%= s.score_value %>/100
          <% if (s.grade) { %> — <span class="grade-pill <%= s.grade.toLowerCase().replace(' ','-') %>" style="font-size:0.6rem;"><%= s.grade %></span><% } %>
        </div>
        <% if (s.diagnosis) { %>
          <div class="timeline-desc"><%= s.diagnosis.substring(0, 120) %><%= s.diagnosis.length > 120 ? '…' : '' %></div>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>
<% } else { %>
<div class="empty-state">
  <div class="icon">◈</div>
  <h3>No history yet</h3>
  <p>Complete your onboarding to generate your first scores and start building your history.</p>
  <a href="/onboarding" class="btn-primary">Start onboarding</a>
</div>
<% } %>