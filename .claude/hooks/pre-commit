#!/usr/bin/env bash
# Maal pre-commit hook: block committed secrets.
#
# Installed by `npm install` (see scripts/install-hooks.js) into .git/hooks/pre-commit.
# Edit THIS file (.claude/hooks/pre-commit), not .git/hooks/pre-commit directly —
# the latter is regenerated on every install and is not tracked by git.
#
# Patterns live in .claude/hooks/secret-patterns.txt, shared with
# scripts/ci-secret-scan.sh so local and CI checks can't drift apart.

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
  exit 0
fi

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATTERNS_FILE="$HOOK_DIR/secret-patterns.txt"

found=0
for f in $staged; do
  # Skip binary files and the hook's own source/pattern file.
  if [ "$f" = ".claude/hooks/pre-commit" ] || [ "$f" = ".claude/hooks/secret-patterns.txt" ]; then continue; fi
  if ! git diff --cached -- "$f" | grep -Iq .; then continue; fi

  while IFS= read -r pat; do
    [ -z "$pat" ] && continue
    case "$pat" in \#*) continue ;; esac
    hit=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -E -e "$pat" || true)
    if [ -n "$hit" ]; then
      echo "pre-commit: possible secret in $f (pattern: $pat)"
      echo "$hit" | sed 's/^/    /'
      found=1
    fi
  done < "$PATTERNS_FILE"
done

if [ "$found" -eq 1 ]; then
  echo ""
  echo "Blocked: staged changes look like they contain a real credential."
  echo "If this is a false positive (e.g. an env var NAME with a placeholder value),"
  echo "adjust the value or add a narrower exception to .claude/hooks/secret-patterns.txt."
  exit 1
fi

exit 0
